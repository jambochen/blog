---
import { SITE_TITLE } from '../consts';
import { withBase } from '../lib/paths';
import Base from '../layouts/Base.astro';
---

<Base title={`找不到頁面 | ${SITE_TITLE}`} description="這一頁不存在。">
	<div class="wrap page">
		<h1>找不到這一頁</h1>
		<p>網址可能打錯了，或文章已經搬走。</p>
		<p><a href={withBase('/')}>回首頁</a>　<a href={withBase('/blog')}>看全部文章</a></p>
	</div>
</Base>
