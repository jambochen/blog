---
import Shelf from '../components/Shelf.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import Base from '../layouts/Base.astro';
import { getEpisodes, groupSeries } from '../lib/posts';
import { routes } from '../lib/siteRoutes';

const STANDALONE_COUNT = 8;

const episodes = await getEpisodes();
// `episodes` is oldest first, so a series' place in it follows its newest episode once reversed: the series written most recently leads.
const allSeries = groupSeries([...episodes].reverse());
const standalone = episodes.filter((episode) => !episode.series).reverse();
---

<Base title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<div class="wrap page">
		<h1 class="sr-only">{SITE_TITLE}</h1>

		{
			allSeries.map((series) => (
				<Shelf name={series.name} href={routes.series(series.slug)} episodes={series.episodes} tone={series.tone} />
			))
		}

		{
			standalone.length > 0 && (
				<Shelf name="單篇文章" href={routes.posts} episodes={standalone.slice(0, STANDALONE_COUNT)} />
			)
		}
		{
			standalone.length > STANDALONE_COUNT && (
				<p class="all">
					<a href={routes.posts}>看全部 {episodes.length} 篇文章</a>
				</p>
			)
		}

		{
			episodes.length === 0 && (
				<p>
					還沒有文章。在 <code>src/content/blog/</code> 新增一個 Markdown 檔，它就會出現在這裡。
				</p>
			)
		}
	</div>
</Base>

<style>
	.page > :global(.shelf + .shelf) {
		margin-top: 1.5rem;
	}
	.all {
		margin: 1.5rem 0 0;
	}
</style>
