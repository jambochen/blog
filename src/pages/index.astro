---
import EpisodeGrid from '../components/EpisodeGrid.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import Base from '../layouts/Base.astro';
import { countWords, getEpisodes, groupSeries } from '../lib/posts';

const STANDALONE_COUNT = 8;

const episodes = await getEpisodes();
// `episodes` is oldest first, so a series' place in it follows its newest episode once reversed: the series written most recently leads.
const allSeries = groupSeries([...episodes].reverse());
const standalone = episodes.filter((episode) => !episode.series).reverse();
const words = episodes.reduce((sum, { post }) => sum + countWords(post.body ?? ''), 0);
---

<Base title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<div class="wrap page">
		<h1>{SITE_TITLE}</h1>
		<p class="intro">
			{SITE_DESCRIPTION}
			{episodes.length > 0 && (
				<span class="stats">
					{episodes.length} 篇 · {words >= 10000 ? `${(words / 10000).toFixed(1)} 萬字` : `${words} 字`}
				</span>
			)}
		</p>

		{
			allSeries.map((series) => (
				<section>
					<h2>
						<a href={`/series/${series.slug}/`}>{series.name}</a>
						<span class="count">共 {series.episodes.length} 篇</span>
					</h2>
					<EpisodeGrid episodes={series.episodes} />
				</section>
			))
		}

		{
			standalone.length > 0 && (
				<section>
					<h2>單篇文章</h2>
					<EpisodeGrid episodes={standalone.slice(0, STANDALONE_COUNT)} />
					{standalone.length > STANDALONE_COUNT && (
						<p class="all">
							<a href="/blog">看全部 {episodes.length} 篇文章</a>
						</p>
					)}
				</section>
			)
		}

		{
			episodes.length === 0 && (
				<p>
					還沒有文章。在 <code>src/content/blog/</code> 新增一個 Markdown 檔，它就會出現在這裡。
				</p>
			)
		}
	</div>
</Base>

<style>
	.intro {
		max-width: var(--measure);
		margin: 0 0 3rem;
		color: var(--muted);
		font-size: 1.125rem;
	}
	.stats {
		display: block;
		margin-top: 0.25rem;
		font-family: var(--font-ui), var(--font-gothic), sans-serif;
		font-size: 0.9rem;
		font-variant-numeric: tabular-nums;
	}
	section + section {
		margin-top: 3.5rem;
	}
	h2 {
		margin: 0 0 1rem;
		font-family: var(--font-mincho);
		font-weight: 900;
		font-size: 1.563rem;
		line-height: 1.3;
	}
	h2 a {
		color: inherit;
		text-decoration: none;
	}
	h2 a:hover {
		color: var(--violet);
	}
	.count {
		margin-left: 0.75rem;
		color: var(--muted);
		font-family: var(--font-gothic);
		font-size: 0.9rem;
		font-weight: 400;
	}
	.all {
		margin: 1.5rem 0 0;
	}
</style>
