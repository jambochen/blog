---
import EpisodeList from '../components/EpisodeList.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import Base from '../layouts/Base.astro';
import { getEpisodes } from '../lib/posts';

const RECENT_COUNT = 8;

const episodes = (await getEpisodes()).reverse();
const recent = episodes.slice(0, RECENT_COUNT);
---

<Base title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<div class="wrap page">
		<h1>{SITE_TITLE}</h1>
		<p class="intro">{SITE_DESCRIPTION}</p>

		{
			recent.length > 0 ? (
				<section>
					<h2>最近的文章</h2>
					<EpisodeList episodes={recent} />
					{episodes.length > recent.length && (
						<p class="all">
							<a href="/blog">看全部 {episodes.length} 篇文章</a>
						</p>
					)}
				</section>
			) : (
				<p>
					還沒有文章。在 <code>src/content/blog/</code> 新增一個 Markdown 檔，它就會出現在這裡。
				</p>
			)
		}
	</div>
</Base>

<style>
	.intro {
		max-width: var(--measure);
		margin: 0 0 3rem;
		color: var(--muted);
		font-size: 1.125rem;
	}
	h2 {
		margin: 0 0 0.75rem;
		font-family: var(--font-mincho);
		font-weight: 900;
		font-size: 1.563rem;
		line-height: 1.3;
	}
	.all {
		margin: 1.5rem 0 0;
	}
</style>
