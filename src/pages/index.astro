---
import Shelf from '../components/Shelf.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import Base from '../layouts/Base.astro';
import { getCatalogue } from '../lib/siteCatalogue';
import { routes } from '../lib/siteRoutes';
import { transitionNames } from '../lib/transitionNames';

const STANDALONE_COUNT = 8;

const { posts, series: allSeries, standalone } = await getCatalogue();
---

<Base title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<div class="wrap page">
		<h1 class="sr-only">{SITE_TITLE}</h1>

		{
			allSeries.map((series) => (
				<Shelf
					name={series.name}
					href={routes.series(series.key)}
					posts={series.episodes}
					tone={series.tone}
					transitionName={transitionNames.series(series.key)}
				/>
			))
		}

		{
			standalone.length > 0 && (
				<Shelf name="單篇文章" href={routes.posts} posts={standalone.slice(0, STANDALONE_COUNT)} />
			)
		}
		{
			standalone.length > STANDALONE_COUNT && (
				<p class="all">
					<a href={routes.posts}>看全部 {posts.length} 篇文章</a>
				</p>
			)
		}

		{
			posts.length === 0 && (
				<p>
					還沒有文章。在 <code>src/content/blog/</code> 新增一個 Markdown 檔，它就會出現在這裡。
				</p>
			)
		}
	</div>
</Base>

<style>
	.page > :global(.shelf + .shelf) {
		margin-top: 1.5rem;
	}
	.all {
		margin: 1.5rem 0 0;
	}
</style>
