---
import PostList from '../components/PostList.astro';
import { SITE_TITLE } from '../consts';
import Base from '../layouts/Base.astro';
import { getCatalogue, type SiteEntry } from '../lib/siteCatalogue';
import { routes } from '../lib/siteRoutes';

const { posts, series: allSeries } = await getCatalogue();

const byYear = new Map<number, SiteEntry[]>();
for (const entry of posts) {
	const year = entry.post.data.pubDate.getUTCFullYear();
	byYear.set(year, [...(byYear.get(year) ?? []), entry]);
}
---

<Base title={`文章 | ${SITE_TITLE}`} description={`全部 ${posts.length} 篇文章，依年份排列。`}>
	<div class="wrap page">
		<h1>文章</h1>
		{
			posts.length === 0 && (
				<p>
					還沒有文章。在 <code>src/content/blog/</code> 新增一個 Markdown 檔就會出現在這裡。
				</p>
			)
		}
		{
			allSeries.length > 0 && (
				<section>
					<h2 class="heading">系列</h2>
					<ul class="series">
						{allSeries.map((series) => (
							<li>
								<a href={routes.series(series.key)}>{series.name}</a>
								<span class="count">共 {series.episodes.length} 篇</span>
							</li>
						))}
					</ul>
				</section>
			)
		}
		{
			[...byYear].map(([year, yearPosts]) => (
				<section>
					<h2 class="heading year">{year}</h2>
					<PostList posts={yearPosts} />
				</section>
			))
		}
	</div>
</Base>

<style>
	.heading {
		margin: 3rem 0 0.75rem;
		font-family: var(--font-mincho);
		font-weight: 900;
		font-size: 1.563rem;
		line-height: 1.2;
	}
	.year {
		font-family: var(--font-ui), sans-serif;
		font-weight: 600;
	}
	.series {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 2.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.series a {
		font-family: var(--font-mincho);
		font-weight: 700;
		font-size: 1.25rem;
	}
	.count {
		margin-left: 0.5rem;
		color: var(--muted);
		font-size: 0.9rem;
	}
</style>
