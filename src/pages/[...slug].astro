---
import { render } from 'astro:content';
import BlogPost from '../layouts/BlogPost.astro';
import type { Turn } from '../lib/catalogue';
import { getCatalogue, type SiteEntry } from '../lib/siteCatalogue';

export async function getStaticPaths() {
	const catalogue = await getCatalogue();
	return catalogue.posts.map((entry) => ({
		params: { slug: entry.id },
		props: { entry, turn: catalogue.neighbours(entry.id) },
	}));
}

interface Props {
	entry: SiteEntry;
	turn: Turn<SiteEntry['post']>;
}

const { entry, turn } = Astro.props;
const { Content, headings, remarkPluginFrontmatter } = await render(entry.post);
const headingTexts: string[] = remarkPluginFrontmatter.headingTexts ?? [];
const outline = headings.map((heading, index) => ({
	...heading,
	text: headingTexts[index] ?? heading.text,
}));
---

<BlogPost entry={entry} turn={turn} headings={outline}>
	<Content />
</BlogPost>
