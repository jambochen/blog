---
import { render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import { type Episode, getEpisodes, groupSeries, neighbours } from '../../lib/posts';

export async function getStaticPaths() {
	const episodes = await getEpisodes();
	const allSeries = groupSeries(episodes);
	return episodes.map((episode) => ({
		params: { slug: episode.post.id },
		props: {
			episode,
			...neighbours(episodes, episode),
			seriesEpisodes: allSeries.find((series) => series.slug === episode.series?.slug)?.episodes,
		},
	}));
}

interface Props {
	episode: Episode;
	previous?: Episode;
	next?: Episode;
	seriesEpisodes?: Episode[];
}

const { episode, previous, next, seriesEpisodes } = Astro.props;
const { Content, headings, remarkPluginFrontmatter } = await render(episode.post);
const headingTexts: string[] = remarkPluginFrontmatter.headingTexts ?? [];
const outline = headings.map((heading, index) => ({
	...heading,
	text: headingTexts[index] ?? heading.text,
}));
---

<BlogPost
	episode={episode}
	previous={previous}
	next={next}
	seriesEpisodes={seriesEpisodes}
	headings={outline}
>
	<Content />
</BlogPost>
