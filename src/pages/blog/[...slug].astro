---
import { render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import { type Episode, getEpisodes, neighbours } from '../../lib/posts';

export async function getStaticPaths() {
	const episodes = await getEpisodes();
	return episodes.map((episode) => ({
		params: { slug: episode.post.id },
		props: { episode, ...neighbours(episodes, episode) },
	}));
}

interface Props {
	episode: Episode;
	previous?: Episode;
	next?: Episode;
}

const { episode, previous, next } = Astro.props;
const { Content, headings, remarkPluginFrontmatter } = await render(episode.post);
const headingTexts: string[] = remarkPluginFrontmatter.headingTexts ?? [];
const outline = headings.map((heading, index) => ({
	...heading,
	text: headingTexts[index] ?? heading.text,
}));
---

<BlogPost episode={episode} previous={previous} next={next} headings={outline}>
	<Content />
</BlogPost>
