---
import EpisodeList from '../../components/EpisodeList.astro';
import { SITE_TITLE } from '../../consts';
import Base from '../../layouts/Base.astro';
import { type Episode, getEpisodes, groupSeries } from '../../lib/posts';

const episodes = (await getEpisodes()).reverse();
const allSeries = groupSeries(episodes);

const byYear = new Map<number, Episode[]>();
for (const episode of episodes) {
	const year = episode.post.data.pubDate.getUTCFullYear();
	byYear.set(year, [...(byYear.get(year) ?? []), episode]);
}
---

<Base title={`文章 | ${SITE_TITLE}`} description={`全部 ${episodes.length} 篇文章，依年份排列。`}>
	<div class="wrap page">
		<h1>文章</h1>
		{
			episodes.length === 0 && (
				<p>
					還沒有文章。在 <code>src/content/blog/</code> 新增一個 Markdown 檔就會出現在這裡。
				</p>
			)
		}
		{
			allSeries.length > 0 && (
				<section>
					<h2 class="heading">系列</h2>
					<ul class="series">
						{allSeries.map((series) => (
							<li>
								<a href={`/blog/${series.slug}/`}>{series.name}</a>
								<span class="count">共 {series.episodes.length} 篇</span>
							</li>
						))}
					</ul>
				</section>
			)
		}
		{
			[...byYear].map(([year, yearEpisodes]) => (
				<section>
					<h2 class="heading year">{year}</h2>
					<EpisodeList episodes={yearEpisodes} />
				</section>
			))
		}
	</div>
</Base>

<style>
	.heading {
		margin: 3rem 0 0.75rem;
		font-family: var(--font-mincho);
		font-weight: 900;
		font-size: 1.563rem;
		line-height: 1.2;
	}
	.year {
		font-family: var(--font-ui), sans-serif;
		font-weight: 600;
	}
	.series {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 2.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.series a {
		font-family: var(--font-mincho);
		font-weight: 700;
		font-size: 1.25rem;
	}
	.count {
		margin-left: 0.5rem;
		color: var(--muted);
		font-size: 0.9rem;
	}
</style>
