---
// The graph is py-spy's own file, cut to its top 20 rows (the import of scipy alone runs some 90 deep).
// It carries its own script and global styles, so it sits in an <iframe>, which keeps both out of the page.
// Its script lays the frames out again to the width it is given, keeping the text at 12px, so it reads in
// the column as it is, and a tap on a frame widens that frame as it does in py-spy's file.
// From `public/`, because the dev server answers a page load of a file under `src/` with its 404 page.
const flameGraph = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/figures/mc-flamegraph.svg`;
const title = 'py-spy 為上例的 Python 版本畫出的火焰圖：最寬的是 mc.py 第 15 行，約佔四分之三，其下是 NumPy 的函數；右側一叢窄而深的區塊是載入 scipy';
---

<figure class="flame">
	<iframe src={flameGraph} title={title} loading="lazy"></iframe>
</figure>

<style>
	.flame {
		margin-inline: 0;
	}
	/* The file is drawn 380 units high and keeps that height at any width. */
	.flame iframe {
		display: block;
		width: 100%;
		height: 380px;
		border: 0;
	}
</style>
