---
import { CHOICES, COMMITS, INITIAL_TARGET, revertTo } from '../lib/figures/revertModes';
import FigureFrame from './FigureFrame.astro';

const { discard, keep, lost, added } = revertTo(INITIAL_TARGET);
---

<FigureFrame
	class="revert"
	label="Two ways to go back to an earlier commit: discarding removes every commit after it, keeping adds one new commit with the old contents"
>
	<div class="actions">
		<span class="prompt">Revert to</span>
		{
			CHOICES.map((name, index) => (
				<button type="button" data-target={index} aria-pressed={index === INITIAL_TARGET}>
					{name}
				</button>
			))
		}
	</div>

	<div class="row" data-mode="discard">
		<span class="name">Discard</span>
		<span class="lost">lost <output data-out="discard">{lost}</output></span>
		<ol class="history">
			{
				COMMITS.map((name, index) => (
					<li data-index={index} data-state={discard[index]}>
						{name}
					</li>
				))
			}
		</ol>
	</div>

	<div class="row" data-mode="keep">
		<span class="name">Keep</span>
		<span class="lost">lost <output>0</output></span>
		<ol class="history">
			{
				COMMITS.map((name, index) => (
					<li data-index={index} data-state={keep[index]}>
						{name}
					</li>
				))
			}
			<li data-state="added" data-out="added">{added}</li>
		</ol>
	</div>
</FigureFrame>

<style>
	.prompt {
		margin-right: 0.25rem;
		color: var(--muted);
	}
	.row {
		display: grid;
		grid-template-columns: 1fr auto;
		gap: 0.4rem 1rem;
		margin-top: 1.25rem;
	}
	.lost {
		color: var(--muted);
	}
	.history {
		grid-column: 1 / -1;
		display: grid;
		/* Six equal slots in both rows, so the same commit lines up between them. */
		grid-template-columns: repeat(6, minmax(0, 1fr));
		gap: 1rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.history li {
		position: relative;
		/* Cancels the spacing the article styles put between list items. */
		margin: 0;
		padding: 0.45rem 0.25rem;
		border: 1px solid var(--ink);
		border-radius: 0;
		background: var(--surface);
		font-family: var(--font-code), monospace;
		font-size: 0.8rem;
		font-weight: 700;
		text-align: center;
		white-space: nowrap;
		transition:
			opacity 0.25s,
			border-color 0.25s,
			background 0.25s,
			color 0.25s;
	}
	/* The line joining a commit to the one before it. */
	.history li + li::before {
		content: '';
		position: absolute;
		top: 50%;
		right: 100%;
		width: 1rem;
		border-top: 1px solid var(--muted);
	}
	.history [data-state='target'] {
		border-color: var(--accent);
		background: var(--tint-accent);
		color: var(--accent);
	}
	.history [data-state='lost'] {
		border-style: dashed;
		border-color: var(--muted);
		background: none;
		color: var(--muted);
		opacity: 0.45;
		text-decoration: line-through;
	}
	.history [data-state='lost']::before {
		border-top-style: dashed;
	}
	.history [data-state='added'] {
		border-color: var(--accent);
		background: var(--accent);
		color: var(--paper);
	}
	.history [data-state='added'][data-fresh] {
		animation: added 0.5s ease;
	}
	@keyframes added {
		from {
			opacity: 0;
			transform: translateX(-0.75rem);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.history li {
			transition: none;
			animation: none !important;
		}
	}
</style>

<script>
	import { revertTo } from '../lib/figures/revertModes';

	for (const figure of document.querySelectorAll<HTMLElement>('.revert')) {
		const buttons = [...figure.querySelectorAll<HTMLButtonElement>('[data-target]')];
		// The `!` are safe: the markup above holds both elements.
		const added = figure.querySelector<HTMLElement>('[data-out="added"]')!;
		const lost = figure.querySelector<HTMLElement>('[data-out="discard"]')!;

		const choose = (target: number) => {
			const view = revertTo(target);
			for (const button of buttons) {
				button.setAttribute('aria-pressed', String(Number(button.dataset.target) === target));
			}
			for (const item of figure.querySelectorAll<HTMLElement>('[data-index]')) {
				const states = item.closest('[data-mode="discard"]') ? view.discard : view.keep;
				const state = states[Number(item.dataset.index)];
				if (state) item.dataset.state = state;
				else item.removeAttribute('data-state');
			}
			lost.textContent = String(view.lost);
			added.textContent = view.added;
			// Detaching the attribute first restarts the entrance animation on every choice.
			added.removeAttribute('data-fresh');
			added.getBoundingClientRect();
			added.setAttribute('data-fresh', '');
		};

		for (const button of buttons) {
			button.addEventListener('click', () => choose(Number(button.dataset.target)));
		}
	}
</script>
