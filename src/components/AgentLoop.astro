---
// One exchange from the post, cut down to a line per step. `kind` decides which arrows light up.
const steps = [
	{ kind: 'ask', text: 'What changed in the latest lme4?' },
	{ kind: 'request', text: 'search "lme4 CRAN NEWS"' },
	{ kind: 'result', text: 'titles, URLs, snippets' },
	{ kind: 'request', text: 'open the CRAN page' },
	{ kind: 'result', text: 'page text' },
	{ kind: 'request', text: 'open NEWS' },
	{ kind: 'result', text: 'full changelog' },
	{ kind: 'answer', text: 'main changes, with sources' },
];
const nodes = ['User', 'LLM', 'Harness', 'Tools'];
---

<figure
	class="loop"
	data-steps={JSON.stringify(steps)}
	aria-label="The agent loop, one step at a time: the LLM requests an action, the harness runs it and returns the result, until the LLM answers"
>
	<div class="actions">
		<button type="button" data-step>Step</button>
		<button type="button" data-reset>Reset</button>
		<span class="count">
			step <output data-out="step">0</output>/{steps.length}
			<span class="loops">loops <output data-out="loops">0</output></span>
		</span>
	</div>

	<div class="stage">
		{
			nodes.map((name, index) => (
				<>
					<span class="node" data-node={index}>
						{name}
					</span>
					{index < nodes.length - 1 && (
						<span class="link" data-link={index}>
							<i class="go" />
							<i class="back" />
						</span>
					)}
				</>
			))
		}
	</div>

	<p class="message" aria-live="polite">
		<span class="kind" data-out="kind"></span>
		<span data-out="text"></span>
	</p>
</figure>

<style>
	.loop {
		margin-inline: 0;
		font-family: var(--font-ui), var(--font-gothic), sans-serif;
		font-size: 0.9rem;
		line-height: 1.5;
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem;
		margin-bottom: 1.25rem;
	}
	.actions button {
		padding: 0.3rem 0.75rem;
		border: 1px solid var(--muted);
		border-radius: 0;
		background: none;
		color: var(--ink);
		font: inherit;
		font-weight: 600;
		cursor: pointer;
	}
	.actions button:hover {
		border-color: var(--ink);
		background: var(--surface);
	}
	.actions [data-reset] {
		color: var(--muted);
	}
	.count {
		margin-left: auto;
		color: var(--muted);
		font-variant-numeric: tabular-nums;
	}
	.loops {
		margin-left: 1rem;
	}
	/* Fixed-width, right-aligned numbers, so nothing shifts as a value changes. */
	output {
		display: inline-block;
		min-width: 2ch;
		color: var(--ink);
		font-weight: 600;
		text-align: right;
	}
	.stage {
		display: flex;
		align-items: stretch;
	}
	.node {
		display: grid;
		place-items: center;
		flex: none;
		min-width: 4.5rem;
		padding: 0.9rem 0.5rem;
		border: 1px solid var(--muted);
		border-radius: 0;
		font-weight: 600;
		transition:
			border-color 0.2s,
			background 0.2s;
	}
	.node[data-active] {
		border-color: var(--accent);
		background: color-mix(in srgb, var(--accent) 12%, transparent);
	}
	.link {
		display: flex;
		flex: 1;
		flex-direction: column;
		justify-content: center;
		gap: 0.9rem;
		min-width: 1.5rem;
		padding-inline: 0.35rem;
	}
	/* An arrow: a line with a head drawn from borders at one end. */
	.link i {
		position: relative;
		height: 1px;
		background: var(--muted);
		opacity: 0.45;
	}
	.link i::before {
		content: '';
		position: absolute;
		top: -3px;
		border: 3.5px solid transparent;
	}
	.link .go::before {
		right: 0;
		border-left-color: var(--muted);
		border-right-width: 0;
	}
	.link .back::before {
		left: 0;
		border-right-color: var(--muted);
		border-left-width: 0;
	}
	.link i[data-active] {
		background: var(--accent);
		opacity: 1;
	}
	.link .go[data-active]::before {
		border-left-color: var(--accent);
	}
	.link .back[data-active]::before {
		border-right-color: var(--accent);
	}
	/* A dot travelling along the active arrow shows which way the text is going. */
	.link i[data-active]::after {
		content: '';
		position: absolute;
		top: -3px;
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: var(--accent);
		animation: travel 0.7s ease-out both;
	}
	.link .back[data-active]::after {
		animation-direction: reverse;
		animation-timing-function: ease-in;
	}
	@keyframes travel {
		from {
			left: 0;
			opacity: 1;
		}
		to {
			left: calc(100% - 7px);
			opacity: 0;
		}
	}
	.message {
		display: flex;
		gap: 0.75rem;
		min-height: 1.5em;
		margin: 1.25rem 0 0;
		font-family: var(--font-code), monospace;
		font-size: 0.85rem;
	}
	.kind {
		flex: none;
		/* "request", the longest of the four */
		min-width: 7ch;
		color: var(--accent);
		font-weight: 700;
		text-align: right;
	}
	@media (prefers-reduced-motion: reduce) {
		.link i[data-active]::after {
			animation: none;
			opacity: 0;
		}
	}
</style>

<script>
	interface Step {
		kind: 'ask' | 'request' | 'result' | 'answer';
		text: string;
	}

	// For each kind: the arrows that carry the text, as [link, direction], and the node it arrives at.
	const ROUTES: Record<Step['kind'], { arrows: [number, 'go' | 'back'][]; arrives: number }> = {
		ask: { arrows: [[0, 'go']], arrives: 1 },
		request: { arrows: [[1, 'go'], [2, 'go']], arrives: 3 },
		result: { arrows: [[2, 'back'], [1, 'back']], arrives: 1 },
		answer: { arrows: [[0, 'back']], arrives: 0 },
	};

	for (const figure of document.querySelectorAll<HTMLElement>('.loop')) {
		const steps: Step[] = JSON.parse(figure.dataset.steps!);
		const output = (name: string) => figure.querySelector<HTMLElement>(`[data-out="${name}"]`)!;
		let current = 0;

		const draw = () => {
			for (const lit of figure.querySelectorAll('[data-active]')) lit.removeAttribute('data-active');
			const step = steps[current - 1];
			output('step').textContent = String(current);
			output('loops').textContent = String(steps.slice(0, current).filter(({ kind }) => kind === 'result').length);
			output('kind').textContent = step?.kind ?? '';
			output('text').textContent = step?.text ?? '';
			if (!step) return;

			const route = ROUTES[step.kind];
			for (const [link, direction] of route.arrows) {
				figure.querySelector(`[data-link="${link}"] .${direction}`)!.setAttribute('data-active', '');
			}
			figure.querySelector(`[data-node="${route.arrives}"]`)!.setAttribute('data-active', '');
		};

		figure.querySelector('[data-step]')!.addEventListener('click', () => {
			// Past the answer, the next press starts the exchange over.
			current = current === steps.length ? 1 : current + 1;
			draw();
		});
		figure.querySelector('[data-reset]')!.addEventListener('click', () => {
			current = 0;
			draw();
		});
	}
</script>
