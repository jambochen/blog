---
import { NODES, STEPS } from '../lib/figures/agentLoop';
import FigureFrame from './FigureFrame.astro';
---

<FigureFrame
	class="loop"
	label="The agent loop, one step at a time: the LLM requests an action, the harness runs it and returns the result, until the LLM answers"
>
	<div class="actions">
		<button type="button" data-step>Step</button>
		<button type="button" data-reset>Reset</button>
		<span class="count">
			step <output data-out="step">0</output>/{STEPS.length}
			<span class="loops">loops <output data-out="loops">0</output></span>
		</span>
	</div>

	<div class="stage">
		{
			NODES.map((name, index) => (
				<>
					<span class="node" data-node={index}>
						{name}
					</span>
					{index < NODES.length - 1 && (
						<span class="link" data-link={index}>
							<i class="go" />
							<i class="back" />
						</span>
					)}
				</>
			))
		}
	</div>

	<p class="message" aria-live="polite">
		<span class="kind" data-out="kind"></span>
		<span data-out="text"></span>
	</p>
</FigureFrame>

<style>
	.count {
		margin-left: auto;
		color: var(--muted);
	}
	.loops {
		margin-left: 1rem;
	}
	.stage {
		display: flex;
		align-items: stretch;
	}
	.node {
		display: grid;
		place-items: center;
		flex: none;
		min-width: 4.5rem;
		padding: 0.9rem 0.5rem;
		border: 1px solid var(--muted);
		border-radius: 0;
		font-weight: 600;
		transition:
			border-color 0.2s,
			background 0.2s;
	}
	.node[data-active] {
		border-color: var(--accent);
		background: var(--tint-accent);
	}
	.link {
		display: flex;
		flex: 1;
		flex-direction: column;
		justify-content: center;
		gap: 0.9rem;
		min-width: 1.5rem;
		padding-inline: 0.35rem;
	}
	/* An arrow: a line with a head drawn from borders at one end. */
	.link i {
		position: relative;
		height: 1px;
		background: var(--muted);
		opacity: 0.45;
	}
	.link i::before {
		content: '';
		position: absolute;
		top: -3px;
		border: 3.5px solid transparent;
	}
	.link .go::before {
		right: 0;
		border-left-color: var(--muted);
		border-right-width: 0;
	}
	.link .back::before {
		left: 0;
		border-right-color: var(--muted);
		border-left-width: 0;
	}
	.link i[data-active] {
		background: var(--accent);
		opacity: 1;
	}
	.link .go[data-active]::before {
		border-left-color: var(--accent);
	}
	.link .back[data-active]::before {
		border-right-color: var(--accent);
	}
	/* A dot travelling along the active arrow shows which way the text is going. */
	.link i[data-active]::after {
		content: '';
		position: absolute;
		top: -3px;
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: var(--accent);
		animation: travel 0.7s ease-out both;
	}
	.link .back[data-active]::after {
		animation-direction: reverse;
		animation-timing-function: ease-in;
	}
	@keyframes travel {
		from {
			left: 0;
			opacity: 1;
		}
		to {
			left: calc(100% - 7px);
			opacity: 0;
		}
	}
	.message {
		display: flex;
		gap: 0.75rem;
		min-height: 1.5em;
		margin: 1.25rem 0 0;
		font-family: var(--font-code), monospace;
		font-size: 0.85rem;
	}
	.kind {
		flex: none;
		/* "request", the longest of the four */
		min-width: 7ch;
		color: var(--accent);
		font-weight: 700;
		text-align: right;
	}
	@media (prefers-reduced-motion: reduce) {
		.link i[data-active]::after {
			animation: none;
			opacity: 0;
		}
	}
</style>

<script>
	import { loopAt, nextStep } from '../lib/figures/agentLoop';

	for (const figure of document.querySelectorAll<HTMLElement>('.loop')) {
		// The `!` is safe: the markup above holds an element for every name asked for here.
		const output = (name: string) => figure.querySelector<HTMLElement>(`[data-out="${name}"]`)!;
		let current = 0;

		const draw = () => {
			for (const lit of figure.querySelectorAll('[data-active]')) lit.removeAttribute('data-active');
			const { step, loops, route } = loopAt(current);
			output('step').textContent = String(current);
			output('loops').textContent = String(loops);
			output('kind').textContent = step?.kind ?? '';
			output('text').textContent = step?.text ?? '';
			if (!route) return;

			for (const [link, direction] of route.arrows) {
				figure.querySelector(`[data-link="${link}"] .${direction}`)?.setAttribute('data-active', '');
			}
			figure.querySelector(`[data-node="${route.arrives}"]`)?.setAttribute('data-active', '');
		};

		figure.querySelector('[data-step]')?.addEventListener('click', () => {
			current = nextStep(current);
			draw();
		});
		figure.querySelector('[data-reset]')?.addEventListener('click', () => {
			current = 0;
			draw();
		});
	}
</script>
