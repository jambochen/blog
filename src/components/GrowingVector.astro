---
import { appendStrip, initialVector, preallocStrip } from '../lib/figures/growingVector';
import FigureFrame from './FigureFrame.astro';

const vector = initialVector();
const rows = [
	{ mode: 'append', name: 'Append', cells: appendStrip(vector) },
	{ mode: 'prealloc', name: 'Preallocate', cells: preallocStrip(vector) },
];
---

<FigureFrame
	class="growing"
	label="Growing a vector: appending moves and copies the whole vector each time, preallocating copies nothing"
>
	<div class="actions">
		<button type="button" data-append>+ Append</button>
		<button type="button" data-reset>Reset</button>
		<span class="length">length <output data-out="length">{vector.length}</output></span>
	</div>

	{
		rows.map(({ mode, name, cells }) => (
			<div class="row">
				<span class="name">{name}</span>
				<span class="copied">
					copied <output data-out={mode}>0</output>
				</span>
				<div class="memory" data-mode={mode}>
					{cells.map(({ state, text }) => (
						<span class="cell" data-state={state}>
							{text}
						</span>
					))}
				</div>
			</div>
		))
	}
</FigureFrame>

<style>
	.length,
	.copied {
		color: var(--muted);
	}
	.length {
		margin-left: auto;
	}
	.row {
		display: grid;
		grid-template-columns: 1fr auto;
		gap: 0.25rem 1rem;
		margin-top: 1rem;
	}
	.memory {
		grid-column: 1 / -1;
		display: grid;
		grid-template-columns: repeat(32, minmax(0, 1fr));
		gap: 2px;
		container-type: inline-size;
	}
	.cell {
		aspect-ratio: 1;
		/* Scales with the strip so two digits still fit a cell on a phone. */
		font-size: clamp(0.45rem, 1.7cqw, 0.75rem);
	}
	.cell[data-state='other'] {
		border: 1px solid color-mix(in srgb, var(--muted) 74%, var(--paper));
		background: var(--tint-muted);
	}
	.cell[data-state='reserved'] {
		border: 1px dashed var(--ink);
	}
	.cell[data-state='value'],
	.cell[data-state='copied'],
	.cell[data-state='new'] {
		border: 1px solid var(--ink);
		background: var(--surface);
	}
	.cell[data-state='copied'] {
		animation: copied 1.2s ease;
	}
	.cell[data-state='new'] {
		animation: written 0.6s ease;
	}
	.cell[data-state='freed'] {
		animation: freed 0.6s ease;
	}
	@keyframes copied {
		0%,
		60% {
			border-color: var(--accent);
			background: var(--tint-accent-strong);
			color: var(--accent);
		}
	}
	@keyframes written {
		0% {
			background: var(--ink);
			color: var(--paper);
		}
	}
	@keyframes freed {
		0% {
			border: 1px solid var(--accent);
			background: var(--tint-accent-strong);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.cell {
			animation: none !important;
		}
	}
</style>

<script>
	import { append, appendStrip, canAppend, type Cell, initialVector, preallocStrip, type Vector } from '../lib/figures/growingVector';

	for (const figure of document.querySelectorAll<HTMLElement>('.growing')) {
		const strip = (mode: string) => [...figure.querySelectorAll<HTMLElement>(`[data-mode="${mode}"] .cell`)];
		const appendCells = strip('append');
		const preallocCells = strip('prealloc');
		// The `!` are safe: the markup above holds an element for every name asked for here.
		const output = (name: string) => figure.querySelector<HTMLElement>(`[data-out="${name}"]`)!;
		const appendButton = figure.querySelector<HTMLButtonElement>('[data-append]')!;
		let vector = initialVector();

		const paint = (cells: HTMLElement[], states: Cell[]) => {
			cells.forEach((cell, index) => {
				const { state, text } = states[index] ?? { state: 'empty', text: '' };
				// Detaching the attribute first restarts the animation when the same state is set twice in a row.
				cell.removeAttribute('data-state');
				cell.getBoundingClientRect();
				cell.dataset.state = state;
				cell.textContent = text;
			});
		};

		const show = (next: Vector) => {
			vector = next;
			paint(appendCells, appendStrip(vector));
			paint(preallocCells, preallocStrip(vector));
			output('length').textContent = String(vector.length);
			output('append').textContent = String(vector.copied);
			appendButton.disabled = !canAppend(vector);
		};

		appendButton.addEventListener('click', () => show(append(vector)));
		figure.querySelector('[data-reset]')?.addEventListener('click', () => show(initialVector()));
	}
</script>
