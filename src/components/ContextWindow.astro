---
import { initialContext, usedPercent, widthPercent } from '../lib/figures/contextWindow';
import FigureFrame from './FigureFrame.astro';

const context = initialContext();
const legend = [
	['system', 'System'],
	['rules', 'Rules'],
	['chat', 'Chat'],
	['file', 'Files'],
	['tool', 'Tools'],
	['summary', 'Summary'],
];
---

<FigureFrame
	class="context"
	label="Context window: add messages, file reads and command output, and watch the fixed-size window fill up and get compacted"
>
	<div class="actions">
		<button type="button" data-add="chat">+ Message</button>
		<button type="button" data-add="file">+ Read file</button>
		<button type="button" data-add="tool">+ Run command</button>
		<button type="button" data-reset>New chat</button>
	</div>

	<div class="window">
		{
			context.blocks.map((block) => (
				<span class="block" data-type={block.type} data-id={block.id} style={`width: ${widthPercent(block)}%`} />
			))
		}
	</div>

	<p class="readout" aria-live="polite">
		<strong data-out="used">{usedPercent(context)}%</strong>
		<span>compacted <output data-out="compactions">0</output>×</span>
	</p>

	<p class="legend">
		{
			legend.map(([type, name]) => (
				<span>
					<i data-type={type} />
					{name}
				</span>
			))
		}
	</p>
</FigureFrame>

<style>
	.actions [data-reset] {
		margin-left: auto;
	}
	.window {
		display: flex;
		height: 3rem;
		overflow: hidden;
		border: 1px solid var(--muted);
		border-radius: 0;
	}
	/* Blocks added by the script carry no scope attribute, hence :global here and on the colours. */
	.window :global(.block) {
		flex: none;
		/* Separates neighbouring blocks of the same colour without changing their widths. */
		box-shadow: inset -1px 0 var(--paper);
		transition: width 0.3s ease;
	}
	.context :global([data-type='system']) {
		background: color-mix(in srgb, var(--ink) 60%, var(--paper));
	}
	.context :global([data-type='rules']) {
		background: color-mix(in srgb, var(--ink) 30%, var(--paper));
	}
	.context :global([data-type='chat']) {
		background: color-mix(in srgb, var(--accent) 60%, var(--paper));
	}
	.context :global([data-type='file']) {
		background: var(--accent);
	}
	.context :global([data-type='tool']) {
		background: var(--amber);
	}
	.context :global([data-type='summary']) {
		background: repeating-linear-gradient(
			-45deg,
			color-mix(in srgb, var(--accent) 60%, var(--paper)) 0 4px,
			color-mix(in srgb, var(--accent) 20%, var(--paper)) 4px 8px
		);
	}
	.readout {
		display: flex;
		align-items: baseline;
		gap: 0.75rem;
		margin: 0.5rem 0 0;
		color: var(--muted);
	}
	.readout strong {
		min-width: 4ch;
		text-align: right;
	}
	.readout [data-flash] {
		color: var(--accent);
	}
	.legend {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1.25rem;
		margin: 0.75rem 0 0;
		padding-top: 0.75rem;
		border-top: 1px solid var(--rule);
		color: var(--muted);
	}
	.legend i {
		display: inline-block;
		width: 0.75rem;
		height: 0.75rem;
		margin-right: 0.4rem;
		border-radius: 0;
		vertical-align: -0.05rem;
	}
	@media (prefers-reduced-motion: reduce) {
		.window :global(.block) {
			transition: none;
		}
	}
</style>

<script>
	import { add, type Context, initialContext, newChat, SIZES, usedPercent, widthPercent } from '../lib/figures/contextWindow';

	// Matches the width transition, after which a removed block leaves the DOM.
	const LEAVE_MS = 300;

	for (const figure of document.querySelectorAll<HTMLElement>('.context')) {
		// The `!` are safe: the markup above holds each of these elements.
		const bar = figure.querySelector<HTMLElement>('.window')!;
		const usedOutput = figure.querySelector<HTMLElement>('[data-out="used"]')!;
		const compactionsOutput = figure.querySelector<HTMLElement>('[data-out="compactions"]')!;

		let context = initialContext();
		const elements = new Map(
			[...bar.querySelectorAll<HTMLElement>('.block')].map((element) => [Number(element.dataset.id), element]),
		);

		const show = (next: Context) => {
			const staying = new Set(next.blocks.map(({ id }) => id));
			for (const [id, element] of elements) {
				if (staying.has(id)) continue;
				elements.delete(id);
				element.style.width = '0';
				setTimeout(() => element.remove(), LEAVE_MS);
			}

			let previous: HTMLElement | undefined;
			next.blocks.forEach((block, index) => {
				let element = elements.get(block.id);
				if (!element) {
					element = document.createElement('span');
					element.className = 'block';
					element.dataset.type = block.type;
					element.style.width = '0';
					// The newest block goes to the end, past the blocks still shrinking away; a summary takes
					// the place of the chat it stands for, right after the blocks that stay in front of it.
					const last = index === next.blocks.length - 1;
					bar.insertBefore(element, last ? null : (previous?.nextSibling ?? bar.firstChild));
					// Read the layout once so the browser animates from zero instead of starting at the final width.
					element.getBoundingClientRect();
					element.style.width = `${widthPercent(block)}%`;
					elements.set(block.id, element);
				}
				previous = element;
			});

			if (next.compactions > context.compactions) {
				compactionsOutput.toggleAttribute('data-flash', true);
				setTimeout(() => compactionsOutput.removeAttribute('data-flash'), 900);
			}
			usedOutput.textContent = `${usedPercent(next)}%`;
			compactionsOutput.textContent = String(next.compactions);
			context = next;
		};

		figure.addEventListener('click', (event) => {
			const button = (event.target as Element).closest('button');
			if (!button) return;
			const type = button.dataset.add;
			if (button.hasAttribute('data-reset')) show(newChat(context));
			else if (type && type in SIZES) show(add(context, type as keyof typeof SIZES));
		});
	}
</script>
