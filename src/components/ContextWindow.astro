---
// Sizes are in thousands of tokens and only illustrative; what matters is their proportion to the window.
const CAPACITY = 200;
const SIZES = { chat: 3, file: 22, tool: 12 };
// `fixed` blocks are written by the framework before the user says anything, and survive a new chat.
const initial = [
	{ type: 'system', size: 18, fixed: true },
	{ type: 'rules', size: 6, fixed: true },
	{ type: 'chat', size: SIZES.chat },
	{ type: 'file', size: SIZES.file },
	{ type: 'tool', size: SIZES.tool },
	{ type: 'chat', size: SIZES.chat },
];
const used = initial.reduce((sum, block) => sum + block.size, 0);
const legend = [
	['system', 'System'],
	['rules', 'Rules'],
	['chat', 'Chat'],
	['file', 'Files'],
	['tool', 'Tools'],
	['summary', 'Summary'],
];
---

<figure
	class="context"
	data-capacity={CAPACITY}
	aria-label="Context window: add messages, file reads and command output, and watch the fixed-size window fill up and get compacted"
>
	<div class="actions">
		<button type="button" data-add="chat" data-size={SIZES.chat}>+ Message</button>
		<button type="button" data-add="file" data-size={SIZES.file}>+ Read file</button>
		<button type="button" data-add="tool" data-size={SIZES.tool}>+ Run command</button>
		<button type="button" data-reset>New chat</button>
	</div>

	<div class="window">
		{
			initial.map(({ type, size, fixed }) => (
				<span
					class="block"
					data-type={type}
					data-size={size}
					data-fixed={fixed}
					style={`width: ${(size / CAPACITY) * 100}%`}
				/>
			))
		}
	</div>

	<p class="readout" aria-live="polite">
		<strong data-out="used">{Math.round((used / CAPACITY) * 100)}%</strong>
		<span>compacted <output data-out="compactions">0</output>×</span>
	</p>

	<p class="legend">
		{
			legend.map(([type, name]) => (
				<span>
					<i data-type={type} />
					{name}
				</span>
			))
		}
	</p>
</figure>

<style>
	.context {
		margin-inline: 0;
		font-family: var(--font-ui), var(--font-gothic), sans-serif;
		font-size: 0.9rem;
		line-height: 1.5;
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-bottom: 1rem;
	}
	.actions button {
		padding: 0.3rem 0.75rem;
		border: 1px solid var(--muted);
		border-radius: 0;
		background: none;
		color: var(--ink);
		font: inherit;
		font-weight: 600;
		cursor: pointer;
	}
	.actions button:hover {
		border-color: var(--ink);
		background: var(--surface);
	}
	.actions [data-reset] {
		margin-left: auto;
		color: var(--muted);
	}
	.window {
		display: flex;
		height: 3rem;
		overflow: hidden;
		border: 1px solid var(--muted);
		border-radius: 0;
	}
	/* Blocks added by the script carry no scope attribute, hence :global here and on the colours. */
	.window :global(.block) {
		flex: none;
		/* Separates neighbouring blocks of the same colour without changing their widths. */
		box-shadow: inset -1px 0 var(--paper);
		transition: width 0.3s ease;
	}
	.context :global([data-type='system']) {
		background: color-mix(in srgb, var(--ink) 60%, var(--paper));
	}
	.context :global([data-type='rules']) {
		background: color-mix(in srgb, var(--ink) 30%, var(--paper));
	}
	.context :global([data-type='chat']) {
		background: color-mix(in srgb, var(--accent) 60%, var(--paper));
	}
	.context :global([data-type='file']) {
		background: var(--accent);
	}
	.context :global([data-type='tool']) {
		background: var(--amber);
	}
	.context :global([data-type='summary']) {
		background: repeating-linear-gradient(
			-45deg,
			color-mix(in srgb, var(--accent) 60%, var(--paper)) 0 4px,
			color-mix(in srgb, var(--accent) 20%, var(--paper)) 4px 8px
		);
	}
	.readout {
		display: flex;
		align-items: baseline;
		gap: 0.75rem;
		margin: 0.5rem 0 0;
		color: var(--muted);
		font-variant-numeric: tabular-nums;
	}
	.readout strong {
		min-width: 4ch;
		color: var(--ink);
		font-size: 2rem;
		line-height: 1.2;
		text-align: right;
	}
	.readout output {
		display: inline-block;
		min-width: 2ch;
		color: var(--ink);
		font-weight: 600;
		text-align: right;
	}
	.readout [data-flash] {
		color: var(--accent);
	}
	.legend {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1.25rem;
		margin: 0.75rem 0 0;
		padding-top: 0.75rem;
		border-top: 1px solid var(--rule);
		color: var(--muted);
	}
	.legend i {
		display: inline-block;
		width: 0.75rem;
		height: 0.75rem;
		margin-right: 0.4rem;
		border-radius: 0;
		vertical-align: -0.05rem;
	}
	@media (prefers-reduced-motion: reduce) {
		.window :global(.block) {
			transition: none;
		}
	}
</style>

<script>
	interface Block {
		type: string;
		size: number;
		fixed: boolean;
		element: HTMLElement;
	}

	// Matches the width transition, after which a removed block leaves the DOM.
	const LEAVE_MS = 300;
	// Compaction summarises the chat only if dropping old tool output did not free enough.
	const SUMMARISE_ABOVE = 0.3;
	const SUMMARY_RATIO = 0.25;

	for (const figure of document.querySelectorAll<HTMLElement>('.context')) {
		const capacity = Number(figure.dataset.capacity);
		const bar = figure.querySelector<HTMLElement>('.window')!;
		const usedOutput = figure.querySelector<HTMLElement>('[data-out="used"]')!;
		const compactionsOutput = figure.querySelector<HTMLElement>('[data-out="compactions"]')!;
		const width = (size: number) => `${(size / capacity) * 100}%`;

		let blocks: Block[] = [...bar.querySelectorAll<HTMLElement>('.block')].map((element) => ({
			type: element.dataset.type!,
			size: Number(element.dataset.size),
			fixed: element.hasAttribute('data-fixed'),
			element,
		}));
		let compactions = 0;

		const total = () => blocks.reduce((sum, block) => sum + block.size, 0);

		const create = (type: string, size: number, before: Element | null): Block => {
			const element = document.createElement('span');
			element.className = 'block';
			element.dataset.type = type;
			element.style.width = '0';
			bar.insertBefore(element, before);
			// Read the layout once so the browser animates from zero instead of starting at the final width.
			element.getBoundingClientRect();
			element.style.width = width(size);
			return { type, size, fixed: false, element };
		};

		const drop = (doomed: Block[]) => {
			blocks = blocks.filter((block) => !doomed.includes(block));
			for (const { element } of doomed) {
				element.style.width = '0';
				setTimeout(() => element.remove(), LEAVE_MS);
			}
		};

		const compact = () => {
			const newest = blocks[blocks.length - 1];
			drop(blocks.filter((block) => block !== newest && (block.type === 'file' || block.type === 'tool')));

			if (total() > capacity * SUMMARISE_ABOVE) {
				const talk = blocks.filter((block) => block !== newest && (block.type === 'chat' || block.type === 'summary'));
				const size = talk.reduce((sum, block) => sum + block.size, 0) * SUMMARY_RATIO;
				const firstLoose = blocks.find((block) => !block.fixed);
				const summary = create('summary', size, firstLoose?.element ?? null);
				blocks.splice(blocks.indexOf(firstLoose ?? newest), 0, summary);
				drop(talk);
			}

			compactions++;
			compactionsOutput.toggleAttribute('data-flash', true);
			setTimeout(() => compactionsOutput.removeAttribute('data-flash'), 900);
		};

		const report = () => {
			usedOutput.textContent = `${Math.round((total() / capacity) * 100)}%`;
			compactionsOutput.textContent = String(compactions);
		};

		figure.addEventListener('click', (event) => {
			const button = (event.target as Element).closest('button');
			if (!button) return;
			if (button.hasAttribute('data-reset')) {
				drop(blocks.filter((block) => !block.fixed));
				compactions = 0;
			} else {
				blocks.push(create(button.dataset.add!, Number(button.dataset.size), null));
				if (total() > capacity) compact();
			}
			report();
		});
	}
</script>
