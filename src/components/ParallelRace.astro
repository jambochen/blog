---
import { FILE_COUNTS, laneAt, raceEnd, WORKERS } from '../lib/figures/parallelRace';
import FigureFrame from './FigureFrame.astro';

// Opens on the larger count, which is the run the post describes first.
const files = Math.max(...FILE_COUNTS);
const scale = raceEnd(files);
const workers = Array.from({ length: WORKERS }, (_, index) => index + 1);
const lanes = [
	{ mode: 'sequential', name: 'Sequential' },
	{ mode: 'parallel', name: 'Parallel' },
].map((lane) => ({ ...lane, ...laneAt(files, lane.mode === 'parallel', 0) }));
const bars = [
	['start', 'overhead'],
	['run', 'work'],
	['merge', 'overhead'],
] as const;
---

<FigureFrame
	class="race"
	label="Sequential and parallel runs of the same files: the parallel run starts its workers first, then computes four files at a time and merges the results"
>
	<div class="actions">
		<button type="button" data-run>Run</button>
		<span class="counts" role="group" aria-label="Files">
			Files
			{
				FILE_COUNTS.map((count) => (
					<button type="button" data-count={count} aria-pressed={count === files ? 'true' : 'false'}>
						{count}
					</button>
				))
			}
		</span>
	</div>

	{
		lanes.map(({ mode, name, phase, clock, cells, cores, spans }) => (
			<div class="lane" data-mode={mode}>
				<div class="head">
					<span class="name">{name}</span>
					<span class="cores">
						{['main', ...workers].map((core, index) => (
							<span class="core" data-state={cores[index]}>
								{core}
							</span>
						))}
					</span>
					<span class="clock">
						<span data-out="phase">{phase}</span>
						<output data-out="time">{clock.toFixed(1)}</output> s
					</span>
				</div>
				<div class="files">
					{cells.map(({ state, progress }) => (
						<span class="cell" data-state={state} style={`--progress: ${progress}`} />
					))}
				</div>
				<div class="track">
					{bars.map(([bar, kind]) => (
						<span
							class:list={['bar', kind]}
							data-bar={bar}
							data-empty={spans[bar] === 0}
							style={`width: ${(spans[bar] / scale) * 100}%`}
						/>
					))}
				</div>
			</div>
		))
	}

	<p class="result" aria-live="polite"><strong data-out="speedup"></strong></p>
</FigureFrame>

<style>
	.race {
		--done: color-mix(in srgb, var(--ink) 16%, transparent);
	}
	/* Wider than between the choices, so Run reads apart from them. Named from the root to outweigh the
	   frame's own gap, which is otherwise as strong and wins or loses by the order of the stylesheets. */
	.race .actions {
		column-gap: 1.5rem;
	}
	.counts {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		color: var(--muted);
	}
	.lane {
		margin-top: 1.25rem;
	}
	.head {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.25rem 1rem;
		margin-bottom: 0.4rem;
	}
	.cores {
		display: flex;
		gap: 3px;
	}
	.core {
		display: grid;
		place-items: center;
		min-width: 1.5rem;
		padding-inline: 0.35rem;
		border: 1px dashed color-mix(in srgb, var(--ink) 30%, transparent);
		color: var(--muted);
		font-family: var(--font-code), monospace;
		font-size: 0.75rem;
		font-weight: 700;
	}
	.core[data-state='starting'] {
		border: 1px solid var(--accent);
		background: linear-gradient(to right, var(--tint-accent-strong) calc(var(--progress) * 100%), transparent 0);
		color: var(--accent);
	}
	.core[data-state='busy'] {
		border: 1px solid var(--ink);
		background: var(--ink);
		color: var(--paper);
	}
	.clock {
		margin-left: auto;
		color: var(--muted);
	}
	/* Holds its width like the numbers do, so the time beside it stays put as the phase changes. */
	.clock [data-out='phase'] {
		display: inline-block;
		/* "merge" */
		min-width: 5ch;
		margin-right: 0.5rem;
		text-align: right;
	}
	.clock [data-out='time'] {
		/* "24.0" */
		min-width: 4ch;
	}
	.files {
		display: grid;
		grid-template-columns: repeat(12, minmax(0, 1fr));
		gap: 2px;
	}
	.cell {
		height: 1.5rem;
		font-size: 0.75rem;
	}
	/* Cells beyond the chosen file count keep their place, so the figure does not change height. */
	.cell[data-state='absent'] {
		visibility: hidden;
	}
	.cell[data-state='running'] {
		border: 1px solid var(--ink);
		background: linear-gradient(to right, var(--done) calc(var(--progress) * 100%), transparent 0);
	}
	.cell[data-state='done'] {
		border: 1px solid var(--ink);
		background: var(--done);
	}
	.track {
		display: flex;
		height: 0.75rem;
		margin-top: 0.4rem;
		border-left: 1px solid var(--muted);
	}
	.bar {
		border: 1px solid;
	}
	.bar[data-empty] {
		border-width: 0;
	}
	.bar.overhead {
		border-color: var(--accent);
		background: var(--tint-accent);
	}
	.bar.work {
		border-color: var(--muted);
		background: var(--tint-muted);
	}
	.result {
		/* Holds the line of the number before a run has finished. */
		min-height: 2.4rem;
		margin: 0.75rem 0 0;
	}
</style>

<script>
	import { FILE_COUNTS, laneAt, raceEnd, speedupLabel } from '../lib/figures/parallelRace';

	const UNIT_MS = 300;

	for (const figure of document.querySelectorAll<HTMLElement>('.race')) {
		// The `!` is safe: the markup above ends with this element.
		const speedup = figure.querySelector<HTMLElement>('[data-out="speedup"]')!;
		const countButtons = [...figure.querySelectorAll<HTMLButtonElement>('[data-count]')];
		let files = Math.max(...FILE_COUNTS);
		let frame = 0;

		const lanes = [...figure.querySelectorAll<HTMLElement>('.lane')].map((lane) => ({
			parallel: lane.dataset.mode === 'parallel',
			cells: [...lane.querySelectorAll<HTMLElement>('.cell')],
			cores: [...lane.querySelectorAll<HTMLElement>('.core')],
			// The `!` are safe: every lane in the markup holds each bar and output asked for below.
			bar: (name: string) => lane.querySelector<HTMLElement>(`[data-bar="${name}"]`)!,
			out: (name: string) => lane.querySelector<HTMLElement>(`[data-out="${name}"]`)!,
		}));

		const draw = (time: number) => {
			const scale = raceEnd(files);
			for (const lane of lanes) {
				const state = laneAt(files, lane.parallel, time);

				lane.cells.forEach((cell, index) => {
					const { state: cellState = 'absent', progress = 0, owner } = state.cells[index] ?? {};
					cell.dataset.state = cellState;
					cell.style.setProperty('--progress', String(progress));
					cell.textContent = owner ? String(owner) : '';
				});
				lane.cores.forEach((core, index) => {
					core.dataset.state = state.cores[index] ?? 'idle';
					core.style.setProperty('--progress', String(state.startProgress));
				});
				for (const [name, length] of Object.entries(state.spans)) {
					const bar = lane.bar(name);
					bar.style.width = `${(length / scale) * 100}%`;
					bar.toggleAttribute('data-empty', length === 0);
				}
				lane.out('phase').textContent = state.phase;
				lane.out('time').textContent = state.clock.toFixed(1);
			}
			speedup.textContent = speedupLabel(files, time);
		};

		const run = () => {
			cancelAnimationFrame(frame);
			const end = raceEnd(files);
			if (matchMedia('(prefers-reduced-motion: reduce)').matches) return draw(end);
			const began = performance.now();
			const tick = (now: number) => {
				const time = Math.min(end, (now - began) / UNIT_MS);
				draw(time);
				if (time < end) frame = requestAnimationFrame(tick);
			};
			frame = requestAnimationFrame(tick);
		};

		figure.querySelector('[data-run]')?.addEventListener('click', run);
		for (const button of countButtons) {
			button.addEventListener('click', () => {
				cancelAnimationFrame(frame);
				files = Number(button.dataset.count);
				countButtons.forEach((other) => other.setAttribute('aria-pressed', String(other === button)));
				draw(0);
			});
		}
	}
</script>
