---
// Times are in units of one file's computation. The start-up and merge costs are chosen so that
// four files finish sooner in sequence and twenty-four finish sooner in parallel.
const FILE_COUNTS = [4, 24];
const WORKERS = 4;
const START = 3;
const MERGE = 1;
const cells = Array.from({ length: Math.max(...FILE_COUNTS) }, (_, index) => index);
const workers = Array.from({ length: WORKERS }, (_, index) => index + 1);
const lanes = [
	['sequential', 'Sequential'],
	['parallel', 'Parallel'],
];
---

<figure
	class="race"
	data-workers={WORKERS}
	data-start={START}
	data-merge={MERGE}
	data-files={FILE_COUNTS.at(-1)}
	aria-label="Sequential and parallel runs of the same files: the parallel run starts its workers first, then computes four files at a time and merges the results"
>
	<div class="actions">
		<button type="button" data-run>Run</button>
		<span class="counts" role="group" aria-label="Files">
			Files
			{
				FILE_COUNTS.map((count) => (
					<button type="button" data-count={count} aria-pressed={count === FILE_COUNTS.at(-1) ? 'true' : 'false'}>
						{count}
					</button>
				))
			}
		</span>
	</div>

	{
		lanes.map(([mode, name]) => (
			<div class="lane" data-mode={mode}>
				<div class="head">
					<span class="name">{name}</span>
					<span class="cores">
						<span class="core" data-core="main">
							main
						</span>
						{workers.map((worker) => (
							<span class="core" data-core={worker}>
								{worker}
							</span>
						))}
					</span>
					<span class="clock">
						<output data-out="phase" />
						<output data-out="time">0.0</output> s
					</span>
				</div>
				<div class="files">
					{cells.map(() => (
						<span class="cell" />
					))}
				</div>
				<div class="track">
					<span class="bar overhead" data-bar="start" />
					<span class="bar work" data-bar="run" />
					<span class="bar overhead" data-bar="merge" />
				</div>
			</div>
		))
	}

	<p class="result" aria-live="polite"><strong data-out="speedup"></strong></p>
</figure>

<style>
	.race {
		--done: color-mix(in srgb, var(--ink) 16%, transparent);
		margin-inline: 0;
		font-family: var(--font-ui), var(--font-gothic), sans-serif;
		font-size: 0.9rem;
		line-height: 1.5;
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem 1.5rem;
		margin-bottom: 0.5rem;
	}
	.counts {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		color: var(--muted);
	}
	.actions button {
		padding: 0.3rem 0.75rem;
		border: 1px solid var(--muted);
		border-radius: 0;
		background: none;
		color: var(--ink);
		font: inherit;
		font-weight: 600;
		font-variant-numeric: tabular-nums;
		cursor: pointer;
	}
	.actions button:hover {
		border-color: var(--ink);
		background: var(--surface);
	}
	.actions button[aria-pressed='true'] {
		border-color: var(--ink);
		background: var(--ink);
		color: var(--paper);
	}
	.lane {
		margin-top: 1.25rem;
	}
	.head {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.25rem 1rem;
		margin-bottom: 0.4rem;
	}
	.name {
		font-weight: 600;
	}
	.cores {
		display: flex;
		gap: 3px;
	}
	.core {
		display: grid;
		place-items: center;
		min-width: 1.5rem;
		padding-inline: 0.35rem;
		border: 1px dashed color-mix(in srgb, var(--ink) 30%, transparent);
		color: var(--muted);
		font-family: var(--font-code), monospace;
		font-size: 0.75rem;
		font-weight: 700;
	}
	.core[data-state='starting'] {
		border: 1px solid var(--accent);
		background: linear-gradient(to right, color-mix(in srgb, var(--accent) 22%, transparent) calc(var(--progress) * 100%), transparent 0);
		color: var(--accent);
	}
	.core[data-state='busy'] {
		border: 1px solid var(--ink);
		background: var(--ink);
		color: var(--paper);
	}
	.clock {
		margin-left: auto;
		color: var(--muted);
		font-variant-numeric: tabular-nums;
	}
	/* Fixed-width, right-aligned fields, so nothing shifts as the phase or the time changes. */
	.clock output {
		display: inline-block;
		text-align: right;
	}
	.clock [data-out='phase'] {
		/* "merge" */
		min-width: 5ch;
		margin-right: 0.5rem;
	}
	.clock [data-out='time'] {
		/* "24.0" */
		min-width: 4ch;
		color: var(--ink);
		font-weight: 600;
	}
	.files {
		display: grid;
		grid-template-columns: repeat(12, minmax(0, 1fr));
		gap: 2px;
	}
	.cell {
		display: grid;
		place-items: center;
		height: 1.5rem;
		border: 1px dashed color-mix(in srgb, var(--ink) 18%, transparent);
		font-family: var(--font-code), monospace;
		font-size: 0.75rem;
		font-weight: 700;
	}
	/* Cells beyond the chosen file count keep their place, so the figure does not change height. */
	.cell[data-state='absent'] {
		visibility: hidden;
	}
	.cell[data-state='running'] {
		border: 1px solid var(--ink);
		background: linear-gradient(to right, var(--done) calc(var(--progress) * 100%), transparent 0);
	}
	.cell[data-state='done'] {
		border: 1px solid var(--ink);
		background: var(--done);
	}
	.track {
		display: flex;
		height: 0.75rem;
		margin-top: 0.4rem;
		border-left: 1px solid var(--muted);
	}
	.bar {
		border: 1px solid;
	}
	.bar[data-empty] {
		border-width: 0;
	}
	.bar.overhead {
		border-color: var(--accent);
		background: color-mix(in srgb, var(--accent) 12%, transparent);
	}
	.bar.work {
		border-color: var(--muted);
		background: color-mix(in srgb, var(--muted) 15%, transparent);
	}
	.result {
		/* Holds the line of the number before a run has finished. */
		min-height: 2.4rem;
		margin: 0.75rem 0 0;
	}
	.result strong {
		font-variant-numeric: tabular-nums;
		font-size: 2rem;
		line-height: 1.2;
	}
</style>

<script>
	const UNIT_MS = 300;
	const clamp = (value: number) => Math.min(1, Math.max(0, value));

	for (const figure of document.querySelectorAll<HTMLElement>('.race')) {
		const workers = Number(figure.dataset.workers);
		const start = Number(figure.dataset.start);
		const merge = Number(figure.dataset.merge);
		const speedup = figure.querySelector<HTMLElement>('[data-out="speedup"]')!;
		const countButtons = [...figure.querySelectorAll<HTMLButtonElement>('[data-count]')];
		let files = Number(figure.dataset.files);
		let frame = 0;

		const lanes = [...figure.querySelectorAll<HTMLElement>('.lane')].map((lane) => ({
			parallel: lane.dataset.mode === 'parallel',
			cells: [...lane.querySelectorAll<HTMLElement>('.cell')],
			cores: [...lane.querySelectorAll<HTMLElement>('.core')],
			bar: (name: string) => lane.querySelector<HTMLElement>(`[data-bar="${name}"]`)!,
			out: (name: string) => lane.querySelector<HTMLElement>(`[data-out="${name}"]`)!,
		}));

		// Each worker takes one run of neighbouring files and works through it in order.
		const schedule = (parallel: boolean) => {
			if (!parallel) return { start: 0, run: files, merge: 0, begins: (index: number) => index, owner: () => 0 };
			const batch = Math.ceil(files / workers);
			return {
				start,
				run: batch,
				merge,
				begins: (index: number) => start + (index % batch),
				owner: (index: number) => Math.floor(index / batch) + 1,
			};
		};
		const finish = (parallel: boolean) => {
			const plan = schedule(parallel);
			return plan.start + plan.run + plan.merge;
		};

		const draw = (time: number) => {
			const scale = Math.max(finish(false), finish(true));
			for (const lane of lanes) {
				const plan = schedule(lane.parallel);
				const end = plan.start + plan.run + plan.merge;
				const clock = Math.min(time, end);
				const phase =
					clock === 0 ? '' : clock < plan.start ? 'start' : clock < plan.start + plan.run ? 'run' : clock < end ? 'merge' : 'done';

				lane.cells.forEach((cell, index) => {
					const progress = clamp(clock - plan.begins(index));
					cell.dataset.state = index >= files ? 'absent' : progress === 0 ? 'waiting' : progress < 1 ? 'running' : 'done';
					cell.style.setProperty('--progress', String(progress));
					cell.textContent = progress > 0 && lane.parallel ? String(plan.owner(index)) : '';
				});

				const used = lane.parallel ? Math.min(workers, files) : 0;
				lane.cores.forEach((core, index) => {
					// The first chip is the main process, which works alone in a sequential run and
					// only hands out and collects in a parallel one.
					if (index === 0) {
						const busy = lane.parallel ? phase === 'start' || phase === 'merge' : phase === 'run';
						core.dataset.state = busy ? 'busy' : 'idle';
					} else if (index > used) core.dataset.state = 'idle';
					else core.dataset.state = phase === 'start' ? 'starting' : phase === 'run' ? 'busy' : 'idle';
					core.style.setProperty('--progress', String(clamp(clock / plan.start)));
				});

				const spans = {
					start: Math.min(clock, plan.start),
					run: clamp((clock - plan.start) / plan.run) * plan.run,
					merge: Math.max(0, clock - plan.start - plan.run),
				};
				for (const [name, length] of Object.entries(spans)) {
					const bar = lane.bar(name);
					bar.style.width = `${(length / scale) * 100}%`;
					bar.toggleAttribute('data-empty', length === 0);
				}

				lane.out('phase').textContent = phase;
				lane.out('time').textContent = clock.toFixed(1);
			}
			speedup.textContent = time >= scale ? `${Number((finish(false) / finish(true)).toFixed(1))}×` : '';
		};

		const run = () => {
			cancelAnimationFrame(frame);
			const end = Math.max(finish(false), finish(true));
			if (matchMedia('(prefers-reduced-motion: reduce)').matches) return draw(end);
			const began = performance.now();
			const tick = (now: number) => {
				const time = Math.min(end, (now - began) / UNIT_MS);
				draw(time);
				if (time < end) frame = requestAnimationFrame(tick);
			};
			frame = requestAnimationFrame(tick);
		};

		figure.querySelector('[data-run]')!.addEventListener('click', run);
		for (const button of countButtons) {
			button.addEventListener('click', () => {
				cancelAnimationFrame(frame);
				files = Number(button.dataset.count);
				countButtons.forEach((other) => other.setAttribute('aria-pressed', String(other === button)));
				draw(0);
			});
		}

		draw(0);
	}
</script>
