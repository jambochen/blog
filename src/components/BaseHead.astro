---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import FallbackImage from '../assets/blog-placeholder-1.jpg';
import { SITE_TITLE } from '../consts';
import { routes } from '../lib/siteRoutes';
import { Font } from 'astro:assets';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const { title, description, image = FallbackImage } = Astro.props;
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href={routes.faviconSvg} />
<link rel="icon" href={routes.faviconIco} />
<link rel="sitemap" href={routes.sitemap} />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL(routes.rss, Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<!-- Runs before first paint so a stored dark preference never flashes light. -->
<script is:inline>
	document.documentElement.dataset.theme =
		localStorage.getItem('theme') ??
		(matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
</script>

<!--
	A named element takes part in a page change wherever it is, so one far down the page would fly in from outside the window.
	Only those in view keep their name for the change; the rest fade with the page. Inline, since `pagereveal` fires before
	the first frame, which a module script can miss.
-->
<script is:inline>
	{
		const unnamed = new Map();
		let latest;
		const restore = () => {
			for (const [element, name] of unnamed) element.style.viewTransitionName = name;
			unnamed.clear();
		};
		const onlyInView = ({ viewTransition }) => {
			// A page kept for the back button comes back with the names it lost when it was left.
			restore();
			if (!viewTransition) return;
			for (const element of document.querySelectorAll('[style*="view-transition-name"], .site-header')) {
				const box = element.getBoundingClientRect();
				if (box.bottom > 0 && box.top < innerHeight && box.right > 0 && box.left < innerWidth) continue;
				unnamed.set(element, element.style.viewTransitionName);
				element.style.viewTransitionName = 'none';
			}
			// Only the latest change gives the names back, so one that ends late does not undo the next.
			const change = (latest = viewTransition);
			const done = () => change === latest && restore();
			viewTransition.finished.then(done, done);
		};
		addEventListener('pageswap', onlyInView);
		addEventListener('pagereveal', onlyInView);
	}
</script>

<Font cssVariable="--font-mincho" />
<Font cssVariable="--font-gothic" />
<!-- The series numbers are set large in this face, so a late swap from the fallback is seen as the number changing. -->
<Font cssVariable="--font-ui" preload={[{ weight: 500, style: 'normal' }]} />
<Font cssVariable="--font-code" />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image.src, Astro.url)} />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
