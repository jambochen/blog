---
import { SITE_TITLE } from '../consts';
import { withBase } from '../lib/paths';

const today = new Date();
---

<footer class="wrap">
	<div class="row">
		<span>&copy; {today.getFullYear()} {SITE_TITLE}</span>
		<span class="links">
			<a href="https://github.com/JamboChen">GitHub</a>
			<a href={withBase('/rss.xml')}>RSS 訂閱</a>
		</span>
	</div>
</footer>
<style>
	footer {
		margin-top: 6rem;
	}
	.row {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 1rem;
		padding-block: 1.5rem 3rem;
		border-top: 1px solid var(--rule);
		color: var(--muted);
		font-size: 0.8rem;
	}
	.links {
		display: flex;
		gap: 1.25rem;
	}
	a {
		color: inherit;
	}
</style>
