---
import { Icon } from 'astro-icon/components';
import { GITHUB_URL, SITE_TITLE } from '../consts';
import { withBase } from '../lib/paths';

const today = new Date();
---

<footer class="wrap">
	<div class="row">
		<span>&copy; {today.getFullYear()} {SITE_TITLE}</span>
		<span class="links">
			<a href={GITHUB_URL} rel="me" aria-label="GitHub" title="GitHub"><Icon name="mdi:github" /></a>
			<a href={withBase('/rss.xml')} aria-label="RSS 訂閱" title="RSS 訂閱"><Icon name="mdi:rss" /></a>
		</span>
	</div>
</footer>
<style>
	footer {
		margin-top: 6rem;
	}
	.row {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 1rem;
		padding-block: 1.5rem 3rem;
		border-top: 1px solid var(--rule);
		color: var(--muted);
		font-size: 0.8rem;
	}
	.links {
		display: flex;
		align-items: center;
		gap: 1rem;
	}
	a {
		display: flex;
		color: inherit;
	}
	a:hover {
		color: var(--ink);
	}
	.links :global(svg) {
		font-size: 1.25rem;
	}
</style>
