---
import type { WallpaperName } from '../lib/wallpapers';

interface Props {
	scene: WallpaperName;
}

const { scene } = Astro.props;
---

<canvas class="wallpaper" data-scene={scene} aria-hidden="true"></canvas>

<style>
	.wallpaper {
		--edge: calc(var(--column) / 2);
		position: fixed;
		inset: 0;
		/* Behind the page content but in front of the paper colour, which sits on <html>. */
		z-index: -1;
		width: 100%;
		height: 100%;
		pointer-events: none;
	}
	/* Each scene says what becomes of it behind the column of text; it is at full strength only in the side margins. */
	.wallpaper[data-column] {
		mask-image: linear-gradient(
			to right,
			#000 calc(50% - var(--edge) - 3rem),
			var(--behind-text) calc(50% - var(--edge)),
			var(--behind-text) calc(50% + var(--edge)),
			#000 calc(50% + var(--edge) + 3rem)
		);
	}
	.wallpaper[data-column='dimmed'] {
		--behind-text: rgb(0 0 0 / 0.3);
	}
	.wallpaper[data-column='hidden'] {
		--behind-text: transparent;
	}
</style>

<script>
	import { WALLPAPERS } from '../lib/wallpapers';
	import { mountScene } from '../lib/wallpapers/host';

	const canvas = document.querySelector<HTMLCanvasElement>('.wallpaper');
	const name = canvas?.dataset.scene;
	if (canvas && name && name in WALLPAPERS) {
		mountScene(canvas, WALLPAPERS[name as keyof typeof WALLPAPERS], { followTheme: true });
	}
</script>
