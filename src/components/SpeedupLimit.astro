---
import { INITIAL, speedupLimit, TOTAL } from '../lib/figures/speedupLimit';
import FigureFrame from './FigureFrame.astro';

const { serial, workers } = INITIAL;
const view = speedupLimit(serial, workers);
const ticks = [0, 2, 4, 6, 8, 10];
---

<FigureFrame
	class="speedup"
	style={`--total: ${TOTAL}; --serial: ${serial}; --workers: ${workers}`}
	label="Speedup limit: set the serial minutes and the number of workers, and compare total run time"
>
	<div class="controls">
		<label>
			<span><i class="fixed"></i>Serial <output data-out="serial">{view.serialLabel}</output></span>
			<input type="range" min="0" max="5" step="0.5" value={serial} data-in="serial" />
		</label>
		<label>
			<span><i class="split"></i>Workers <output data-out="workers">{workers}</output></span>
			<input type="range" min="1" max="32" step="1" value={workers} data-in="workers" />
		</label>
	</div>

	<div class="chart">
		<span class="name">1</span>
		<div class="track">
			<span class="bar fixed" data-bar="serial">{view.bars.serial.label}</span>
			<span class="bar split whole" data-bar="whole">{view.bars.whole.label}</span>
		</div>
		<span class="name" data-out="name">{workers}</span>
		<div class="track">
			<span class="bar fixed" data-bar="serial">{view.bars.serial.label}</span>
			<span class="bar split shared" data-bar="shared">{view.bars.shared.label}</span>
		</div>
		<span></span>
		<div class="axis">
			{ticks.map((tick) => <span style={`left: ${(tick / TOTAL) * 100}%`}>{tick}</span>)}
			<em>min</em>
		</div>
	</div>

	<p class="result" aria-live="polite">
		<strong data-out="speedup">{view.speedup}</strong>
		<span data-out="limit">{view.limit}</span>
	</p>
</FigureFrame>

<style>
	.controls {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
		gap: 0.75rem 2rem;
		margin-bottom: 1.5rem;
	}
	.controls label {
		display: grid;
		gap: 0.25rem;
		color: var(--muted);
	}
	.controls output {
		margin-left: 0.5rem;
	}
	.controls output[data-out='serial'] {
		/* "0.5 min" */
		min-width: 7ch;
	}
	.controls input {
		width: 100%;
		margin: 0;
		accent-color: var(--accent);
	}
	.chart {
		display: grid;
		grid-template-columns: max-content minmax(0, 1fr);
		align-items: center;
		gap: 0.9rem 1rem;
		/* Room for the axis unit, which hangs past the last tick. */
		padding-right: 3rem;
	}
	.name {
		min-width: 2ch;
		font-variant-numeric: tabular-nums;
		text-align: right;
	}
	.track {
		display: flex;
		gap: 3px;
		height: 2rem;
	}
	/* The widths are computed here from the two custom properties, so the script only has to set those. */
	.bar {
		display: grid;
		place-items: center;
		overflow: hidden;
		border: 1px solid;
		border-radius: 0;
		font-weight: 600;
		white-space: nowrap;
		transition: width 0.25s ease;
	}
	.bar.fixed {
		width: calc(var(--serial) / var(--total) * 100%);
		border-color: var(--accent);
		background: var(--tint-accent);
		color: var(--accent);
	}
	.bar.split {
		border-color: var(--muted);
		background: var(--tint-muted);
	}
	.bar.whole {
		width: calc((var(--total) - var(--serial)) / var(--total) * 100%);
	}
	.bar.shared {
		width: calc((var(--total) - var(--serial)) / var(--workers) / var(--total) * 100%);
	}
	/* A bar too narrow for its label, or of zero length, shows no text or border. */
	.bar[data-tight] {
		color: transparent;
	}
	.bar[data-empty] {
		border-width: 0;
	}
	.axis {
		position: relative;
		height: 1.6rem;
		border-top: 1px solid var(--muted);
		color: var(--muted);
		font-family: var(--font-code), monospace;
		font-size: 0.8rem;
	}
	.axis span {
		position: absolute;
		top: 0.3rem;
		transform: translateX(-50%);
	}
	.axis span::before {
		content: '';
		position: absolute;
		top: -0.3rem;
		left: 50%;
		height: 0.3rem;
		border-left: 1px solid var(--muted);
	}
	.axis em {
		position: absolute;
		top: 0.3rem;
		left: calc(100% + 1rem);
		font-style: normal;
	}
	.result {
		display: flex;
		align-items: baseline;
		gap: 0.75rem;
		margin: 0.5rem 0 0;
		color: var(--muted);
	}
	/* The swatches beside the slider names double as the legend for the bars. */
	.controls i {
		display: inline-block;
		width: 0.75rem;
		height: 0.75rem;
		margin-right: 0.5rem;
		border: 1px solid;
		border-radius: 0;
		vertical-align: -0.05rem;
	}
	.controls .fixed {
		border-color: var(--accent);
		background: var(--tint-accent);
	}
	.controls .split {
		border-color: var(--muted);
		background: var(--tint-muted);
	}
	@media (prefers-reduced-motion: reduce) {
		.bar {
			transition: none;
		}
	}
</style>

<script>
	import { type Bar, speedupLimit } from '../lib/figures/speedupLimit';

	for (const figure of document.querySelectorAll<HTMLElement>('.speedup')) {
		// The `!` are safe: the markup above holds an element for every name asked for here.
		const input = (name: string) => figure.querySelector<HTMLInputElement>(`[data-in="${name}"]`)!;
		const output = (name: string) => figure.querySelector<HTMLElement>(`[data-out="${name}"]`)!;

		const label = (name: string, { label, empty, tight }: Bar) => {
			for (const bar of figure.querySelectorAll<HTMLElement>(`[data-bar="${name}"]`)) {
				bar.textContent = label;
				bar.toggleAttribute('data-empty', empty);
				bar.toggleAttribute('data-tight', tight);
			}
		};

		figure.addEventListener('input', () => {
			const serial = Number(input('serial').value);
			const workers = Number(input('workers').value);
			const view = speedupLimit(serial, workers);

			figure.style.setProperty('--serial', String(serial));
			figure.style.setProperty('--workers', String(workers));
			output('serial').textContent = view.serialLabel;
			output('workers').textContent = String(workers);
			output('name').textContent = String(workers);
			label('serial', view.bars.serial);
			label('whole', view.bars.whole);
			label('shared', view.bars.shared);
			output('speedup').textContent = view.speedup;
			output('limit').textContent = view.limit;
		});
	}
</script>
