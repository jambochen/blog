---
import type { MarkdownHeading } from 'astro';

interface Props {
	headings: MarkdownHeading[];
}

const headings = Astro.props.headings.filter(({ depth }) => depth === 2 || depth === 3);
---

{
	headings.length > 1 && (
		<>
			<nav class="outline outline-side" aria-label="本文大綱">
				<div class="outline-rail" aria-hidden="true">
					{headings.map(({ depth }) => (
						<span class={`depth-${depth}`} />
					))}
				</div>
				<div class="outline-panel">
					<p class="outline-title">大綱</p>
					<ol>
						{headings.map(({ depth, slug, text }) => (
							<li class={`depth-${depth}`}>
								<a href={`#${slug}`}>{text}</a>
							</li>
						))}
					</ol>
				</div>
			</nav>

			<details class="outline outline-inline">
				<summary>大綱</summary>
				<ol>
					{headings.map(({ depth, slug, text }) => (
						<li class={`depth-${depth}`}>
							<a href={`#${slug}`}>{text}</a>
						</li>
					))}
				</ol>
			</details>
		</>
	)
}

<script>
	const links = [...document.querySelectorAll<HTMLAnchorElement>('.outline-side a')];
	const targets = links
		.map((link) => document.getElementById(decodeURIComponent(link.hash.slice(1))))
		.filter((target) => target !== null);

	if (targets.length > 0) {
		const items = links.map((link) => link.parentElement!);
		const ticks = [...document.querySelectorAll('.outline-rail span')];
		// Subsections are hidden by CSS only once this is set, so the full outline stays visible without script.
		document.querySelector<HTMLElement>('.outline-side')!.dataset.collapsible = '';
		// A heading counts as current once it has scrolled into the top part of the viewport.
		const READING_LINE = 120;
		let queued = false;

		const update = () => {
			queued = false;
			let current = -1;
			targets.forEach((target, index) => {
				if (target.getBoundingClientRect().top <= READING_LINE) current = index;
			});
			links.forEach((link, index) => {
				if (index === current) link.setAttribute('aria-current', 'location');
				else link.removeAttribute('aria-current');
				ticks[index].toggleAttribute('data-current', index === current);
			});

			// Only the section being read shows its subsections.
			const isSection = (index: number) => items[index].classList.contains('depth-2');
			let start = current;
			while (start > 0 && !isSection(start)) start--;
			let end = start + 1;
			while (end < items.length && !isSection(end)) end++;
			items.forEach((item, index) => {
				item.toggleAttribute('data-open', current >= 0 && index > start && index < end);
			});
		};

		addEventListener(
			'scroll',
			() => {
				if (queued) return;
				queued = true;
				requestAnimationFrame(update);
			},
			{ passive: true },
		);
		update();
	}
</script>

<style>
	.outline ol {
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.outline a {
		display: block;
		padding-block: 0.3rem;
		color: var(--muted);
		font-size: 0.9rem;
		line-height: 1.5;
		text-decoration: none;
	}
	.outline a:hover {
		color: var(--ink);
	}
	.depth-3 a {
		padding-left: 1rem;
	}

	/* Only the rail is in flow, so the panel opens when the pointer reaches the rail, not anywhere in the empty column. */
	.outline-side {
		position: sticky;
		top: 2rem;
		width: fit-content;
		margin-left: auto;
	}
	.outline-rail {
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		gap: 0.55rem;
		padding: 0.5rem 0 0.5rem 1rem;
	}
	.outline-rail span {
		width: 1.25rem;
		height: 2px;
		background: color-mix(in srgb, var(--muted) 55%, var(--paper));
	}
	.outline-rail .depth-3 {
		width: 0.7rem;
	}
	.outline-rail [data-current] {
		background: var(--violet);
	}
	.outline-panel {
		position: absolute;
		top: 0;
		right: 0;
		/* The width of the column BlogPost reserves beside the text, so the open panel never covers it. */
		width: 13rem;
		max-height: calc(100vh - 4rem);
		overflow-y: auto;
		padding: 0.5rem 0 0.5rem 1rem;
		border-left: 1px solid var(--rule);
		background: var(--paper);
		/* Not `visibility: hidden`, so the links stay reachable by keyboard and focusing one opens the panel. */
		opacity: 0;
		pointer-events: none;
		transform: translateX(0.75rem);
		transition:
			opacity 0.2s ease,
			transform 0.2s ease;
	}
	.outline-side:hover .outline-panel,
	.outline-side:focus-within .outline-panel {
		opacity: 1;
		pointer-events: auto;
		transform: none;
	}
	.outline-title {
		margin: 0 0 0.5rem;
		font-family: var(--font-mincho);
		font-weight: 900;
	}
	.outline-side[data-collapsible] li.depth-3 {
		max-height: 0;
		overflow: hidden;
		opacity: 0;
		/* Keeps collapsed links out of the tab order; delayed on closing so the fade can finish. */
		visibility: hidden;
		transition:
			max-height 0.25s ease,
			opacity 0.25s ease,
			visibility 0s 0.25s;
	}
	.outline-side[data-collapsible] li.depth-3[data-open] {
		/* Room for a title that wraps onto three lines. */
		max-height: 6rem;
		opacity: 1;
		visibility: visible;
		transition-delay: 0s;
	}
	@media (prefers-reduced-motion: reduce) {
		.outline-side .depth-3,
		.outline-panel {
			transition: none !important;
		}
	}
	.outline-side a[aria-current] {
		color: var(--violet);
		font-weight: 700;
	}

	.outline-inline {
		display: none;
		max-width: var(--measure);
		margin-bottom: 2.5rem;
		padding: 0.75rem 1rem;
		background: var(--surface);
	}
	.outline-inline summary {
		font-family: var(--font-mincho);
		font-weight: 900;
		cursor: pointer;
	}
	.outline-inline ol {
		margin-top: 0.5rem;
	}

	@media (max-width: 1000px) {
		.outline-side {
			display: none;
		}
		.outline-inline {
			display: block;
		}
	}
</style>
