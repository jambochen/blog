---
import { withBase } from '../lib/paths';
import type { Episode, Tone } from '../lib/posts';
import FormattedDate from './FormattedDate.astro';

interface Props {
	name: string;
	href: string;
	episodes: Episode[];
	tone?: Tone;
}

const { name, href, episodes, tone } = Astro.props;
---

<section class="shelf" data-tone={tone}>
	<h2>
		<a href={href}>{name}</a>
		<span class="count">共 {episodes.length} 篇</span>
	</h2>
	<ol>
		{
			episodes.map(({ post, series }) => (
				<li>
					<a href={withBase(`/blog/${post.id}/`)}>
						{series ? (
							<span class="number">{String(series.number).padStart(2, '0')}</span>
						) : (
							<FormattedDate date={post.data.pubDate} />
						)}
						<span class="title">{post.data.title}</span>
						<span class="description">{post.data.description}</span>
					</a>
				</li>
			))
		}
	</ol>
</section>

<style>
	.shelf {
		background: var(--tone);
		color: var(--block-ink);
	}
	h2 {
		margin: 0;
		padding: 1.25rem 1.1rem;
		font-family: var(--font-mincho);
		font-weight: 900;
		font-size: 2.441rem;
		line-height: 1.15;
	}
	/* The heavy mincho has no condensed cut, so the glyphs are squeezed; the wider box makes lines break where the squeezed text reaches the column edge. */
	h2 a {
		--squeeze: 0.76;
		display: block;
		width: calc(100% / var(--squeeze));
		transform: scaleX(var(--squeeze));
		transform-origin: left top;
		color: inherit;
		letter-spacing: -0.02em;
		text-decoration: none;
		text-wrap: balance;
	}
	h2 a:hover {
		text-decoration: underline;
		text-decoration-thickness: 2px;
	}
	.count {
		display: block;
		margin-top: 0.75rem;
		font-family: var(--font-gothic);
		font-size: 0.85rem;
		font-weight: 400;
		line-height: 1.6;
	}
	ol {
		margin: 0;
		padding: 0;
		list-style: none;
	}
	li {
		margin: 0;
		border-top: 1px solid color-mix(in srgb, var(--block-ink) 35%, transparent);
	}
	li a {
		display: grid;
		grid-template-columns: 2.75rem minmax(0, 1fr);
		column-gap: 0.5rem;
		align-items: baseline;
		padding: 0.9rem 1.1rem 1rem;
		color: inherit;
		text-decoration: none;
		transition:
			background-color 0.15s ease,
			color 0.15s ease;
	}
	.number,
	li :global(.date) {
		color: inherit;
		font-family: var(--font-ui), sans-serif;
		font-size: 1.25rem;
		font-weight: 500;
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
	}
	.title {
		grid-column: 2;
		font-family: var(--font-mincho);
		font-weight: 700;
		font-size: 1.25rem;
		line-height: 1.45;
	}
	.description {
		grid-column: 2;
		margin-top: 0.25rem;
		font-size: 0.85rem;
		line-height: 1.6;
		opacity: 0.85;
	}
	li a:hover,
	li a:focus-visible {
		background: var(--block-ink);
		color: var(--tone);
	}
	li a:focus-visible {
		outline-offset: -4px;
	}
	/* Browsers let a visited link change colours and nothing else, so reading progress is shown by the number or date. */
	li a:visited:not(:hover, :focus-visible) :is(.number, :global(.date)) {
		color: var(--amber);
	}

	/* Without a fill the section has no edge of its own, so rules close it and the heading drops the inset a fill needs. */
	.shelf[data-tone='page'] {
		/* Lets the wallpaper show through; the filled tones cover it. */
		background: none;
		border-block: 0.3rem solid var(--block-ink);
	}
	.shelf[data-tone='page'] h2 {
		padding-left: 0;
	}
	/* Amber is too faint on the light page. */
	.shelf[data-tone='page'] li a:visited:not(:hover, :focus-visible) :is(.number, :global(.date)) {
		color: var(--accent);
	}

	@media (min-width: 52rem) {
		.shelf {
			display: grid;
			grid-template-columns: minmax(0, 17rem) minmax(0, 1fr);
		}
		h2 {
			padding: 1.75rem 1.5rem;
			font-size: 3.815rem;
		}
		li {
			border-left: 1px solid color-mix(in srgb, var(--block-ink) 35%, transparent);
		}
		li:first-child {
			border-top: 0;
		}
		li a {
			grid-template-columns: 3.25rem minmax(0, 5fr) minmax(0, 6fr);
			column-gap: 1rem;
			padding: 0.85rem 1.5rem 0.95rem;
		}
		.number {
			font-size: 1.563rem;
		}
		.description {
			grid-column: 3;
			margin: 0;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		li a {
			transition: none;
		}
	}
</style>
