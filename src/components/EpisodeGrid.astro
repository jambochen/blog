---
import type { Episode } from '../lib/posts';
import FormattedDate from './FormattedDate.astro';

interface Props {
	episodes: Episode[];
}

const { episodes } = Astro.props;
---

<ol class="grid">
	{
		episodes.map(({ post, series }) => (
			<li>
				<a href={`/blog/${post.id}/`}>
					<span class="head">
						{series ? (
							<span class="number">{String(series.number).padStart(2, '0')}</span>
						) : (
							<FormattedDate date={post.data.pubDate} />
						)}
						{/* Decorative: the title beside it already names the post. */}
						{post.data.thumbnail && <img src={post.data.thumbnail.src} alt="" width="300" height="200" loading="lazy" />}
					</span>
					<span class="title">{post.data.title}</span>
					<span class="description">{post.data.description}</span>
				</a>
			</li>
		))
	}
</ol>

<style>
	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
		margin: 0;
		/* Tiles overlap by their border width so shared edges are one line thick; this keeps the outer edge inside the column. */
		padding: 0 1px 1px 0;
		list-style: none;
	}
	li {
		display: flex;
		margin: 0 -1px -1px 0;
	}
	a {
		position: relative;
		display: flex;
		flex: 1;
		flex-direction: column;
		min-height: 9.5rem;
		padding: 1rem 1.1rem 1.25rem;
		border: 1px solid var(--rule);
		color: inherit;
		text-decoration: none;
		transition:
			background-color 0.15s ease,
			border-color 0.15s ease;
	}
	/* A fixed height, so titles line up across a row whether or not a tile has a picture. */
	.head {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		height: 4.5rem;
	}
	img {
		width: auto;
		height: 100%;
		margin: -0.25rem -0.25rem 0 0;
	}
	.number {
		color: var(--muted);
		font-family: var(--font-ui), sans-serif;
		font-size: 1.75rem;
		font-weight: 300;
		font-variant-numeric: tabular-nums;
		line-height: 1.2;
		transition: color 0.15s ease;
	}
	.title {
		margin-top: 0.5rem;
		font-family: var(--font-mincho);
		font-weight: 700;
		font-size: 1.125rem;
		line-height: 1.45;
	}
	.description {
		margin-top: 0.35rem;
		color: var(--muted);
		font-size: 0.85rem;
		line-height: 1.6;
	}
	/* Raised so the highlighted border is not covered by the neighbours that overlap it. */
	a:hover,
	a:focus-visible {
		z-index: 1;
		border-color: var(--ink);
		background: var(--surface);
	}
	/* Browsers let a visited link change colours and nothing else, so reading progress is shown by the tile's number or date. */
	a:visited .number,
	a:visited :global(.date) {
		color: var(--violet);
	}
	@media (prefers-reduced-motion: reduce) {
		a,
		.number {
			transition: none;
		}
	}
</style>
