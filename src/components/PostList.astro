---
import { episodeLabel, placementLabel } from '../lib/catalogue';
import type { SiteEntry } from '../lib/siteCatalogue';
import { routes } from '../lib/siteRoutes';
import { transitionNames } from '../lib/transitionNames';
import FormattedDate from './FormattedDate.astro';

interface Props {
	posts: SiteEntry[];
	showSeries?: boolean;
}

const { posts, showSeries = true } = Astro.props;
---

<ol class="posts">
	{
		posts.map(({ id, post, series, placement }) => (
			<li>
				<a href={routes.post(id)}>
					<span class="text">
						{series && placement && (
							<span class="series">
								{showSeries ? `${series.name}　${placementLabel(placement)}` : episodeLabel(placement.number)}
							</span>
						)}
						<span class="title" style={{ viewTransitionName: transitionNames.post(id) }}>
							{post.data.title}
						</span>
						<span class="description">{post.data.description}</span>
					</span>
					<FormattedDate date={post.data.pubDate} />
				</a>
			</li>
		))
	}
</ol>

<style>
	.posts {
		list-style: none;
		margin: 0;
		padding: 0;
		border-bottom: 1px solid var(--rule);
	}
	a {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		align-items: baseline;
		column-gap: 1.5rem;
		padding-block: 1.1rem;
		border-top: 1px solid var(--rule);
		color: inherit;
		text-decoration: none;
	}
	.series {
		display: block;
		color: var(--muted);
		font-size: 0.8rem;
		line-height: 1.6;
	}
	.title {
		display: block;
		font-family: var(--font-mincho);
		font-weight: 700;
		font-size: 1.25rem;
		line-height: 1.45;
	}
	.description {
		display: block;
		color: var(--muted);
		font-size: 0.9rem;
		line-height: 1.6;
	}
	a:hover .title {
		color: var(--accent);
	}
</style>
