---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header class="site-header">
	<nav class="wrap" aria-label="主選單">
		<a class="site-name" href="/">{SITE_TITLE}</a>
		<div class="links">
			<HeaderLink href="/blog">文章</HeaderLink>
			<HeaderLink href="/about">關於</HeaderLink>
			<HeaderLink href="/search">搜尋</HeaderLink>
			<button type="button" id="theme-toggle">切到深色</button>
		</div>
	</nav>
</header>

<script>
	const toggle = document.querySelector<HTMLButtonElement>('#theme-toggle');
	const root = document.documentElement;
	const label = () => (root.dataset.theme === 'dark' ? '切到淺色' : '切到深色');

	if (toggle) {
		toggle.textContent = label();
		toggle.addEventListener('click', () => {
			root.dataset.theme = root.dataset.theme === 'dark' ? 'light' : 'dark';
			localStorage.setItem('theme', root.dataset.theme);
			toggle.textContent = label();
		});
	}
</script>

<style>
	.site-header {
		background: var(--bar);
		color: var(--bar-ink);
		font-family: var(--font-mincho);
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		min-height: 3.5rem;
	}
	.site-name {
		font-weight: 900;
		font-size: 1.25rem;
		color: inherit;
		text-decoration: none;
	}
	.links {
		display: flex;
		align-items: center;
		gap: 1.5rem;
	}
	.links :global(a) {
		color: inherit;
		font-weight: 700;
		padding-block: 0.25rem;
		border-bottom: 3px solid transparent;
	}
	.links :global(a:hover),
	.links :global(a.active) {
		border-bottom-color: var(--amber);
	}
	button {
		font: inherit;
		font-size: 0.8rem;
		font-weight: 700;
		color: inherit;
		background: none;
		border: 1px solid color-mix(in srgb, var(--bar-ink) 45%, transparent);
		padding: 0.15rem 0.6rem;
		cursor: pointer;
	}
	button:hover {
		border-color: var(--bar-ink);
	}
	@media (max-width: 420px) {
		.links {
			gap: 1rem;
		}
	}
</style>
