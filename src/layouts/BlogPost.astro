---
import type { MarkdownHeading } from 'astro';
import DangoFamily from '../components/DangoFamily.astro';
import MermaidDiagrams from '../components/MermaidDiagrams.astro';
import PostHeader from '../components/PostHeader.astro';
import PostOutline from '../components/PostOutline.astro';
import ToBeContinued from '../components/ToBeContinued.astro';
import XrefPreview from '../components/XrefPreview.astro';
import { SITE_TITLE } from '../consts';
import type { Turn } from '../lib/catalogue';
import type { SiteEntry } from '../lib/siteCatalogue';
import { routes } from '../lib/siteRoutes';
import { transitionNames } from '../lib/transitionNames';
import Base from './Base.astro';

interface Props {
	entry: SiteEntry;
	turn: Turn<SiteEntry['post']>;
	headings: MarkdownHeading[];
}

const { entry, turn, headings } = Astro.props;
const { previous, next, stillToCome, continues } = turn;
const { title, description } = entry.post.data;
---

<Base title={`${title} | ${SITE_TITLE}`} description={description} wallpaper="threeBody" card={routes.postCard(entry.id)}>
	<article data-pagefind-body data-tone={entry.series?.tone}>
		<PostHeader entry={entry} />
		<div class="wrap body">
			<div class="prose">
				<slot />
				{
					entry.placement && (
						<DangoFamily
							size={entry.placement.total + entry.placement.unpublished.length}
							current={entry.placement.slot}
							unborn={entry.placement.unpublished}
						/>
					)
				}
			</div>
			<aside class="side" data-pagefind-ignore>
				<PostOutline headings={headings} />
			</aside>
		</div>
	</article>
	<XrefPreview />

	{
		(next || previous || continues) && (
			<nav class:list={['wrap', 'after', 'turn', { continues }]} aria-label="前後篇">
				{next && (
					<a class="turn-row" href={routes.post(next.id)}>
						{continues ? <ToBeContinued label="下一篇" /> : <span class="turn-label">下一篇</span>}
						<span class="turn-title" style={{ viewTransitionName: transitionNames.post(next.id) }}>
							{next.post.data.title}
						</span>
					</a>
				)}
				{stillToCome > 0 && (
					<p class="turn-row">
						<ToBeContinued />
						<span class="turn-label">未完待續，後面還有 {stillToCome} 篇</span>
					</p>
				)}
				{previous && (
					<a class="turn-row" href={routes.post(previous.id)}>
						<span class="turn-label">上一篇</span>
						<span class="turn-title" style={{ viewTransitionName: transitionNames.post(previous.id) }}>
							{previous.post.data.title}
						</span>
					</a>
				)}
			</nav>
		)
	}

	<MermaidDiagrams />
</Base>

<style>
	.body {
		display: grid;
		grid-template-columns: minmax(0, var(--measure)) minmax(0, 13rem);
		justify-content: space-between;
		column-gap: 3rem;
	}
	/* The outline is second in the source so the article text comes first for screen readers; on narrow screens it moves above the text. */
	@media (max-width: 1000px) {
		.body {
			display: flex;
			flex-direction: column-reverse;
		}
	}
	.after {
		margin-top: 4rem;
	}
	.turn-row {
		display: grid;
		grid-template-columns: var(--turn-label, 4.5rem) minmax(0, 1fr);
		align-items: center;
		gap: 0.4rem 1rem;
		max-width: var(--measure);
		margin: 0;
		padding-block: 0.9rem;
		border-top: 1px solid var(--rule);
		color: inherit;
		text-decoration: none;
	}
	.turn-row:last-child {
		border-bottom: 1px solid var(--rule);
	}
	/* Every row takes the arrow's width, so the titles stay in one column. */
	.turn.continues {
		--turn-label: 11.75rem;
	}
	@media (max-width: 34rem) {
		.turn.continues .turn-row {
			grid-template-columns: minmax(0, 1fr);
		}
	}
	.turn-label {
		color: var(--muted);
	}
	.turn-title {
		font-family: var(--font-mincho);
		font-weight: 700;
	}
	.turn a:hover :is(.turn-title, .turn-label) {
		color: var(--accent);
	}
</style>
