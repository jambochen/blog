---
import type { MarkdownHeading } from 'astro';
import MermaidDiagrams from '../components/MermaidDiagrams.astro';
import PostHeader from '../components/PostHeader.astro';
import PostOutline from '../components/PostOutline.astro';
import { SITE_TITLE } from '../consts';
import type { Episode } from '../lib/posts';
import Base from './Base.astro';

interface Props {
	episode: Episode;
	previous?: Episode;
	next?: Episode;
	seriesEpisodes?: Episode[];
	headings: MarkdownHeading[];
}

const { episode, previous, next, seriesEpisodes, headings } = Astro.props;
const { title, description } = episode.post.data;
---

<Base title={`${title} | ${SITE_TITLE}`} description={description}>
	<article data-pagefind-body data-tone={episode.series?.tone}>
		<PostHeader episode={episode} />
		<div class="wrap body">
			<div class="prose">
				<slot />
			</div>
			<aside class="side" data-pagefind-ignore>
				<PostOutline headings={headings} />
			</aside>
		</div>
	</article>

	{
		episode.series && seriesEpisodes && (
			<nav class="wrap after contents" aria-label="系列目錄">
				<h2>
					<a href={`/series/${episode.series.slug}/`}>{episode.series.name}</a>
					<span class="contents-total">共 {episode.series.total} 篇</span>
				</h2>
				<ol>
					{seriesEpisodes.map((item) => (
						<li>
							{item.post.id === episode.post.id ? (
								<span aria-current="page">{item.post.data.title}（本篇）</span>
							) : (
								<a href={`/blog/${item.post.id}/`}>{item.post.data.title}</a>
							)}
						</li>
					))}
				</ol>
			</nav>
		)
	}

	{
		(next || previous) && (
			<nav class="wrap after turn" aria-label="前後篇">
				{next && (
					<a href={`/blog/${next.post.id}/`}>
						<span class="turn-label">下一篇</span>
						<span class="turn-title">{next.post.data.title}</span>
					</a>
				)}
				{previous && (
					<a href={`/blog/${previous.post.id}/`}>
						<span class="turn-label">上一篇</span>
						<span class="turn-title">{previous.post.data.title}</span>
					</a>
				)}
			</nav>
		)
	}

	<MermaidDiagrams />
</Base>

<style>
	.body {
		display: grid;
		grid-template-columns: minmax(0, var(--measure)) minmax(0, 13rem);
		justify-content: space-between;
		column-gap: 3rem;
	}
	/* The outline is second in the source so the article text comes first for screen readers; on narrow screens it moves above the text. */
	@media (max-width: 1000px) {
		.body {
			display: flex;
			flex-direction: column-reverse;
		}
	}
	.after {
		margin-top: 4rem;
	}
	.contents + .turn {
		margin-top: 2.5rem;
	}
	.contents h2 {
		margin: 0 0 0.5rem;
		font-family: var(--font-mincho);
		font-size: 1.25rem;
		font-weight: 900;
		line-height: 1.4;
	}
	.contents h2 a {
		color: inherit;
	}
	.contents-total {
		margin-left: 0.75rem;
		color: var(--muted);
		font-size: 0.9rem;
		font-weight: 400;
	}
	.contents ol {
		max-width: var(--measure);
		margin: 0;
		padding-left: 1.75rem;
	}
	.contents li {
		padding-block: 0.2rem;
	}
	.contents li::marker {
		color: var(--muted);
	}
	.contents [aria-current] {
		font-weight: 700;
	}
	.turn a {
		display: grid;
		grid-template-columns: 4.5rem minmax(0, 1fr);
		column-gap: 1rem;
		max-width: var(--measure);
		padding-block: 0.9rem;
		border-top: 1px solid var(--rule);
		color: inherit;
		text-decoration: none;
	}
	.turn a:last-child {
		border-bottom: 1px solid var(--rule);
	}
	.turn-label {
		color: var(--muted);
	}
	.turn-title {
		font-family: var(--font-mincho);
		font-weight: 700;
	}
	.turn a:hover .turn-title {
		color: var(--accent);
	}
</style>
