---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Wallpaper from '../components/Wallpaper.astro';
import type { WallpaperName } from '../lib/wallpapers';

interface Props {
	title: string;
	description: string;
	wallpaper?: WallpaperName;
	card?: string;
}

const { title, description, wallpaper = 'terrain', card } = Astro.props;
---

<!doctype html>
<html lang="zh-Hant">
	<head>
		<BaseHead title={title} description={description} card={card} />
		<slot name="head" />
	</head>
	<body>
		<Wallpaper scene={wallpaper} />
		<Header />
		<main>
			<slot />
		</main>
		<Footer />
	</body>
</html>
